#!/bin/bash
# Pre-commit hook to detect accidentally committed secrets
# Install: git config core.hooksPath .githooks

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo "🔍 Checking for accidentally committed secrets..."

# Patterns that look like real API keys
SECRET_PATTERNS=(
    'sk-proj-[A-Za-z0-9]{20,}'           # OpenAI project keys
    'sk-ant-[A-Za-z0-9]{20,}'            # Anthropic keys
    'gsk_[A-Za-z0-9]{20,}'               # Groq keys
    'AIza[A-Za-z0-9_-]{35}'              # Google API keys
    'AKIA[A-Z0-9]{16}'                   # AWS Access Keys
    'xox[baprs]-[A-Za-z0-9-]{10,}'       # Slack tokens
    'ghp_[A-Za-z0-9]{36}'                # GitHub personal access tokens
    'glpat-[A-Za-z0-9_-]{20}'            # GitLab personal access tokens
)

# Files to check (staged files only)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FOUND_SECRET=0

for pattern in "${SECRET_PATTERNS[@]}"; do
    # Check staged content for each pattern
    MATCHES=$(git diff --cached -U0 | grep -E "^\+.*$pattern" || true)
    if [ -n "$MATCHES" ]; then
        echo -e "${RED}❌ Potential secret detected matching pattern: $pattern${NC}"
        echo "$MATCHES" | head -5
        FOUND_SECRET=1
    fi
done

# Also check .env.example files specifically for non-placeholder values
for file in $STAGED_FILES; do
    if [[ "$file" == *".env.example"* ]]; then
        # Check for lines that look like they have real values (long alphanumeric strings)
        SUSPICIOUS=$(git diff --cached "$file" | grep -E '^\+[A-Z_]+=[A-Za-z0-9_-]{30,}' | grep -v 'your-' | grep -v 'example' | grep -v 'placeholder' || true)
        if [ -n "$SUSPICIOUS" ]; then
            echo -e "${RED}❌ Suspicious values in $file (looks like real secrets):${NC}"
            echo "$SUSPICIOUS"
            FOUND_SECRET=1
        fi
    fi
done

if [ $FOUND_SECRET -eq 1 ]; then
    echo ""
    echo -e "${RED}🚨 Commit blocked: Potential secrets detected!${NC}"
    echo ""
    echo "If these are intentional placeholder values, you can:"
    echo "  1. Use obvious placeholder text like 'your-api-key-here'"
    echo "  2. Skip this check with: git commit --no-verify"
    echo ""
    exit 1
fi

# Second pass: gitleaks (100+ maintained rules + entropy heuristics).
# Soft dependency — warn if missing so OSS contributors aren't blocked,
# but run it strictly when available.
if command -v gitleaks >/dev/null 2>&1; then
    echo "🔍 Running gitleaks on staged changes..."
    if ! gitleaks protect --staged --redact --no-banner --verbose; then
        echo ""
        echo -e "${RED}🚨 Commit blocked: gitleaks detected potential secrets.${NC}"
        echo ""
        echo "If a finding is a false positive (e.g. a doc placeholder), either:"
        echo "  1. Reword the value to make it obviously fake (e.g. 'your-key-here')"
        echo "  2. Add a targeted allow-rule to .gitleaks.toml"
        echo "  3. Skip this check with: git commit --no-verify"
        echo ""
        exit 1
    fi
else
    echo -e "${YELLOW}⚠️  gitleaks not installed — skipping deep scan.${NC}"
    echo "    Install for better coverage: brew install gitleaks"
fi

echo -e "${GREEN}✅ No secrets detected${NC}"
exit 0
