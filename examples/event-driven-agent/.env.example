# =============================================================================
# Event-Driven Agent - Environment Configuration
# =============================================================================
# Copy to .env: cp .env.example .env
#
# This agent receives Prometheus AlertManager webhooks and orchestrates
# autonomous incident response using AI-driven DAG planning.
# =============================================================================

# =============================================================================
# Setup-Only Skill Synchronization (Optional)
# =============================================================================
# The setup script warns and continues if automatic skill synchronization
# fails. Use another Skills API address when registry.localhost is not routed
# from this host, or skip only the automatic attempt. Explicit skills-sync and
# skills-check commands remain strict.
#TRUVAG3_SKILLS_API_URL=http://registry.localhost/api/v1/skills
#TRUVAG3_SKIP_SKILLS_SYNC=true

# =============================================================================
# AI Provider API Keys (Chain Client with failover)
# =============================================================================
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#TRUVAG3_OPENROUTER_MODEL_DEFAULT=openai/gpt-5.6-sol
# Exact :free routes are experimental; no built-in OpenRouter free alias is advertised.
#GROQ_API_KEY=gsk-your-groq-key-here
#GEMINI_API_KEY=your-gemini-key-here

# =============================================================================
# Model Alias Overrides (Optional)
# =============================================================================
TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-5.6-terra
TRUVAG3_OPENAI_MODEL_FAST=gpt-5.6-luna
TRUVAG3_OPENAI_MODEL_SMART=gpt-5.6-sol

# =============================================================================
# Service Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379
PORT=8372
NAMESPACE=truvag3-examples
APP_ENV=development

# Deployment mode: "api", "worker", or "" (embedded, default for local dev)
TRUVAG3_MODE=

# Number of background workers (default: 3)
WORKER_COUNT=3

# =============================================================================
# Event Agent Configuration
# =============================================================================

# Enable critical alert queue processing (default: true)
TRUVAG3_EVENT_CRITICAL_QUEUE=true

# Enable warning-level Slack notifications (default: true)
TRUVAG3_EVENT_WARNING_SLACK=true

# Dedup TTL in seconds — should match or exceed AlertManager repeat_interval (30m = 1800s)
TRUVAG3_EVENT_DEDUP_TTL=1800

# Slack channel for critical alert investigation results (used in AI prompt)
#TRUVAG3_SLACK_CHANNEL_INCIDENTS=#incidents

# Slack channel for warning-level notifications (direct call to slack-tool)
#TRUVAG3_SLACK_CHANNEL_NOTIFICATIONS=#notifications

# =============================================================================
# HITL (Human-in-the-Loop) Configuration
# =============================================================================
# Write operations (pod restart, scaling, etc.) require human approval.

TRUVAG3_HITL_ENABLED=true
TRUVAG3_HITL_REQUIRE_PLAN_APPROVAL=false

# Agent identity — scopes the HITL checkpoint store's Redis key prefix to this
# agent. Required when running multiple HITL-enabled agents against the same
# Redis; without it they share truvag3:hitl:pending and the registry viewer's
# HITL list will duplicate. Change the value if you rename this agent or run
# multiple instances.
TRUVAG3_AGENT_NAME=event-driven-agent-service

# Destructive operations that require step-level approval
# Notifications (create_ticket, send_message, send_rich_message) are allowed without approval
TRUVAG3_HITL_STEP_SENSITIVE_CAPABILITIES=rollout_restart,scale_deployment,delete_pod

# Timeout and defaults
TRUVAG3_HITL_DEFAULT_TIMEOUT=5m
#TRUVAG3_HITL_ESCALATE_AFTER_RETRIES=3

# Webhook URL the controller calls when a checkpoint is created.
# In-cluster: http://event-driven-agent-service.truvag3-examples/internal/hitl-webhook
TRUVAG3_HITL_WEBHOOK_URL=http://event-driven-agent-service.truvag3-examples/internal/hitl-webhook

# Development mode
DEV_MODE=false

# =============================================================================
# Telemetry Configuration
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# LLM Debug Store
TRUVAG3_LLM_DEBUG_ENABLED=true

# Execution Debug Store (stores orchestration DAGs in Redis DB 8)
# View in Registry Viewer: http://localhost:8361 -> Execution DAG tab
TRUVAG3_EXECUTION_DEBUG_STORE_ENABLED=true

# =============================================================================
# Result Trimming (Large Data Management)
# =============================================================================
# DevOps tools return large responses (kubectl describe, pod logs can be 500KB+).
# Increase trim budgets so pod logs and resource details are not dropped.
TRUVAG3_RESULT_TRIM_MAX_BYTES=65536
TRUVAG3_RESULT_TRIM_MAX_TOTAL_BYTES=100000

# =============================================================================
# Timeout Configuration
# =============================================================================
# Agent-to-agent delegation (e.g., devops-chat-agent) needs longer timeouts
TRUVAG3_ORCHESTRATION_TIMEOUT=15m
TRUVAG3_EXECUTION_STEP_TIMEOUT=5m
TRUVAG3_ITERATIVE_PHASE_TIMEOUT=5m

# HTTP server timeouts must accommodate full orchestration duration
TRUVAG3_HTTP_WRITE_TIMEOUT=15m
TRUVAG3_HTTP_READ_TIMEOUT=15m

# =============================================================================
# Logging
# =============================================================================
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
#TRUVAG3_DEBUG=true

# =============================================================================
# Shared Agent Memory (Cross-Agent Episodic Events + Vector Knowledge)
# =============================================================================
# Domain groups agents that share memory. Agents in the same domain see each
# other's episodic events and investigation claims.
TRUVAG3_AGENT_DOMAIN=infrastructure

# Deploy Qdrant vector DB during infrastructure setup (setup.sh full-deploy / infra)
# Set to true to enable semantic knowledge search across agents.
# Agents degrade gracefully without it (episodic memory still works via Redis).
TRUVAG3_DEPLOY_QDRANT=true

# Vector DB for semantic knowledge search (Phase 2)
# Local Kind: qdrant.truvag3-examples:6334 | Local dev: localhost:6334
TRUVAG3_VECTOR_DB_URL=qdrant.truvag3-examples:6334
#TRUVAG3_VECTOR_DB_COLLECTION=truvag3_knowledge
#TRUVAG3_VECTOR_DB_VECTOR_SIZE=768

# Embedding endpoint for knowledge extraction and semantic search
# Local Kind (Ollama on host Mac): http://host.docker.internal:11434/v1
# Local dev: http://localhost:11434/v1
# OpenAI: https://api.openai.com/v1 (set TRUVAG3_EMBEDDING_API_KEY, TRUVAG3_VECTOR_DB_VECTOR_SIZE=1536)
TRUVAG3_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
TRUVAG3_EMBEDDING_MODEL=nomic-embed-text
#TRUVAG3_EMBEDDING_API_KEY=
