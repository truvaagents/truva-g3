# DevOps Tool Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8347)
PORT=8347

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
DEV_MODE=true

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Redis / Valkey connection overrides
# Local execution defaults to standalone DB 0 at localhost:6379. Kubernetes
# manifests provide the in-cluster standalone URL. Uncomment only to override.
# REDIS_URL=redis://localhost:6379/0
#
# Cluster alternative. Never set this together with REDIS_URL.
# For Kubernetes, prefer k8-deployment/setup-redis-cluster-validation.sh so the
# URL shorthand is cleared before these structured settings are applied.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

TRUVAG3_LOG_LEVEL=info

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. This tool requires NO external API keys — it uses in-cluster
#    kubectl with a ServiceAccount for Kubernetes API access.
#
# 3. For local testing (requires kubectl configured with a kubeconfig):
#    set -a && source .env && set +a
#    go run .
#
# 4. For Kubernetes deployment:
#    ./setup.sh deploy
