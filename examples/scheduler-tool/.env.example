# Scheduler Tool - Environment Variables
# Copy this file to .env and adjust values as needed
#
# scheduler-tool is a framework primitive deployed as a BaseTool. It exposes
# 5 scheduling capabilities (schedule_task, list_schedules, get_schedule,
# update_schedule, cancel_schedule) and runs a background tick loop that
# promotes due schedules into target agent task queues.
#
# Unlike most example tools, scheduler-tool does NOT require any external
# API key — its only external dependency is Redis (used for both schedule
# storage and the distributed leader lock).

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (registry allocation)
PORT=8379

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode — enables relaxed framework validation for local dev
# Set to "true" for local development, "false" in K8s.
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL — used for schedule storage, task dispatch, distributed lock,
# and service discovery. Format: redis://[username:password@]host:port[/db]
# Examples:
#   - Local: redis://localhost:6379
#   - K8s:   redis://redis.truvag3-examples:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Scheduler Tuning (Optional)
# ==============================================================================

# How often the scheduler tick loop polls for due schedules (Go duration)
# Smaller values reduce dispatch latency but increase Redis load.
TRUVAG3_SCHEDULER_TICK_INTERVAL=5s

# Distributed lock TTL — must be greater than TRUVAG3_SCHEDULER_TICK_INTERVAL.
# This is the worst-case delay before another replica can take over after a
# leader crash. Larger values are safer against clock skew, smaller values
# enable faster failover.
TRUVAG3_SCHEDULER_LOCK_TTL=30s

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json — use "text" for local readability)
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# Service name for K8s service discovery (default: derived from tool name)
TRUVAG3_K8S_SERVICE_NAME=scheduler-tool-service

# Service port used for K8s registration / discovery metadata
TRUVAG3_K8S_SERVICE_PORT=80

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# OpenTelemetry collector endpoint
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# APP_ENV switches the telemetry profile (development | staging | production)
APP_ENV=development

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis.truvag3-examples:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Start a local Redis:
#    docker run --rm -p 6379:6379 redis:8.2.8-alpine
#
# 3. Run the tool locally:
#    ./setup.sh run
#
# 4. Or deploy to a Kind cluster:
#    ./setup.sh full-deploy
