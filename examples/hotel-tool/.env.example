# Hotel Tool - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8343)
PORT=8343

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
# Set to "true" for local development
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Format: redis://[username:password@]host:port[/database]
# Examples:
#   - Local: redis://localhost:6379
#   - K8s: redis://redis-service.truvag3-examples.svc.cluster.local:6379
#   - Auth: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# LiteAPI Configuration (REQUIRED)
# ==============================================================================

# LiteAPI key for hotel data + live rates + reviews.
# Sign up at: https://dashboard.liteapi.travel
# Free sandbox tier includes ~1,000 requests/month against real hotel inventory
# with realistic pricing (sandbox rates are test rates but use real hotels).
#
# Sandbox keys are prefixed with "sand_" (e.g., sand_67b69242-...).
# Production keys are prefixed with "prod_" and require signing up for a paid plan.
LITEAPI_KEY=your-liteapi-key-here

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# Application environment for telemetry profile selection
# Values: development (100% sampling), staging (10%), production (0.1%)
APP_ENV=development

# OpenTelemetry collector endpoint
# Format: http://host:port
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for telemetry. Must match the pod's `app:` label and the
# core.WithName() value in main.go — otherwise Loki/Jaeger/Prometheus will
# split observability across different service names. Leave unset to let the
# framework default to the core.WithName() value.
OTEL_SERVICE_NAME=hotel-tool

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json for production)
# Use "text" for easier local development reading
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# K8s Service resource name for cluster-internal discovery URL construction.
# Must match the Service resource defined in k8-deployment.yaml.
TRUVAG3_K8S_SERVICE_NAME=hotel-tool-service

# Pod name - automatically set by K8s (don't set manually)
# TRUVAG3_K8S_POD_NAME=hotel-service-xyz123

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis-service.truvag3-examples.svc.cluster.local:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get your LiteAPI key:
#    - Sign up at: https://dashboard.liteapi.travel
#    - Copy the sandbox key from your dashboard
#    - Paste it into LITEAPI_KEY above
#
# 3. For local testing:
#    export $(cat .env | xargs)
#    go run .
#
# 4. For Kubernetes deployment:
#    Update the secret in k8-deployment.yaml with your credentials
#
