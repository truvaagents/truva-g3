# Currency Global Tool Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8346)
PORT=8346

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
DEV_MODE=true

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Application Configuration
# ==============================================================================

# CurrencyBeacon API key (REQUIRED for currency data)
# Get your FREE API key from: https://currencybeacon.com/register
# Free tier includes:
#   - 5,000 API calls per month
#   - 170+ fiat currencies
#   - Hourly rate updates
#   - /convert and /latest endpoints
CURRENCYBEACON_API_KEY=your-currencybeacon-api-key-here

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

TRUVAG3_LOG_LEVEL=info

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get your CurrencyBeacon API key:
#    - Visit: https://currencybeacon.com/register
#    - Sign up for a free account
#    - Copy your API key from the dashboard
#    - Paste it in CURRENCYBEACON_API_KEY above
#
# 3. For local testing:
#    set -a && source .env && set +a
#    go run .
#
# 4. For Kubernetes deployment:
#    ./setup.sh deploy
