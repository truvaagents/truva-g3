      "id": 12,
      "title": "Embeddings",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "collapsed": true,
      "panels": [
        {
          "id": 13,
          "title": "Embedding Duration P95",
          "type": "timeseries",
          "gridPos": {
            "h": 8,
            "w": 12,
