      "targets": [
        {
          "expr": "sum(rate(truvag3_memory_evictions_total{job=\"otel-collector-metrics\"}[5m])) by (service_name)",
          "refId": "A",
          "legendFormat": "{{service_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
