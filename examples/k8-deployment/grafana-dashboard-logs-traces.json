{
  "uid": "truvag3-logs-traces",
  "title": "TruvaG3 Logs & Traces",
  "tags": [
    "truvag3",
    "logs",
    "traces",
    "loki",
    "jaeger"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "truvag3"
      ],
      "title": "TruvaG3 Dashboards",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Metrics",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "loki_ds",
        "type": "datasource",
        "query": "loki",
        "label": "Logs",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "jaeger_ds",
        "type": "datasource",
        "query": "jaeger",
        "label": "Traces",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "service_name",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "loki",
          "uid": "${loki_ds}"
        },
        "query": "label_values({service_name=~\".+\"}, service_name)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      },
      {
        "name": "trace_service",
        "type": "query",
        "label": "Trace Service",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(truvag3_http_server_request_duration_seconds_count{job=\"otel-collector-metrics\"}, service_name)",
        "query": {
          "query": "label_values(truvag3_http_server_request_duration_seconds_count{job=\"otel-collector-metrics\"}, service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "selected": true,
          "text": "maintenance-agent",
          "value": "maintenance-agent"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Log Volume by Service",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service_name\"} [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Error Log Count (5m)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"$service_name\"} | detected_level=\"ERROR\" [5m])) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "ERROR-level log lines (by the log's level field) in the last 5 minutes."
    },
    {
      "id": 4,
      "title": "Error Log Stream",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "id": 5,
      "title": "Error Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "{service_name=~\"$service_name\"} | detected_level=\"ERROR\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "ERROR-level log lines (by the log's level field), newest first."
    },
    {
      "id": 6,
      "title": "Traces",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "Trace Search",
      "type": "table",
      "datasource": {
        "type": "jaeger",
        "uid": "${jaeger_ds}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "${jaeger_ds}"
          },
          "queryType": "search",
          "service": "$trace_service",
          "limit": 20
        }
      ],
      "description": "Recent traces for the selected Trace Service (Jaeger search needs a single service). Jaeger keeps only the most recent 15,000 traces in memory.",
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "HTTP Traffic Detail",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": [
        {
          "id": 9,
          "title": "HTTP Status Code Distribution",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 29
          },
          "targets": [
            {
              "expr": "sum by (http_response_status_code) (rate(truvag3_http_server_request_duration_seconds_count{job=\"otel-collector-metrics\", service_name=~\"$service_name\", http_route!=\"/api/capabilities\"}[5m]))",
              "instant": false,
              "range": true,
              "legendFormat": "{{http_response_status_code}}",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "fillOpacity": 10,
                "drawStyle": "line",
                "lineWidth": 1,
                "pointSize": 5,
                "showPoints": "auto",
                "axisPlacement": "auto",
                "spanNulls": false
              },
              "color": {
                "mode": "palette-classic"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "200"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "green"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "400"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "yellow"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "404"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "yellow"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "500"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "red"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "502"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "red"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "503"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "red"
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi"
            }
          },
          "description": "HTTP responses by status code, excluding /api/capabilities discovery polling."
        },
        {
          "id": 10,
          "title": "HTTP Server Latency (mean & bucket estimate)",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 29
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(truvag3_http_server_request_duration_seconds_bucket{job=\"otel-collector-metrics\", service_name=~\"$service_name\", http_route!=\"/api/capabilities\"}[5m])))",
              "instant": false,
              "range": true,
              "legendFormat": "{{service_name}} p95 (bucket-limited)",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            },
            {
              "expr": "sum by (service_name) (rate(truvag3_http_server_request_duration_seconds_sum{job=\"otel-collector-metrics\", service_name=~\"$service_name\", http_route!=\"/api/capabilities\"}[5m])) / (sum by (service_name) (rate(truvag3_http_server_request_duration_seconds_count{job=\"otel-collector-metrics\", service_name=~\"$service_name\", http_route!=\"/api/capabilities\"}[5m])) > 0)",
              "instant": false,
              "range": true,
              "legendFormat": "{{service_name}} mean",
              "refId": "B",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "fillOpacity": 10,
                "drawStyle": "line",
                "lineWidth": 1,
                "pointSize": 5,
                "showPoints": "auto",
                "axisPlacement": "auto",
                "spanNulls": false
              },
              "color": {
                "mode": "palette-classic"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi"
            }
          },
          "description": "Excludes /api/capabilities polling. P95 can't resolve below 5 ms or above 10 s (default buckets, code item C3); use the mean for fast endpoints."
        }
      ]
    },
    {
      "id": 11,
      "title": "All Logs",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": [
        {
          "id": 12,
          "title": "Full Log Stream",
          "type": "logs",
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 30
          },
          "targets": [
            {
              "expr": "{service_name=~\"$service_name\"} | detected_level!=\"DEBUG\"",
              "refId": "A",
              "datasource": {
                "type": "loki",
                "uid": "${loki_ds}"
              }
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": true,
            "showCommonLabels": false,
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "sortOrder": "Descending",
            "dedupStrategy": "none"
          },
          "description": "All non-DEBUG log lines, newest first."
        }
      ]
    }
  ],
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": ""
}
