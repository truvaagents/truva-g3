          "expr": "histogram_quantile(0.95, sum(rate(truvag3_plan_generation_duration_ms_bucket{job=\"otel-collector-metrics\", service_name=~\"$service_name\"}[5m])) by (le))",
          "refId": "B",
          "legendFormat": "P95"
        }
