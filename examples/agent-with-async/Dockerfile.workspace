# Workspace Dockerfile for async-travel-agent
# This Dockerfile builds with LOCAL modules (for development/testing with local changes)
# Usage (from truvag3 root): docker build -f examples/agent-with-async/Dockerfile.workspace -t async-travel-agent:latest .

FROM golang:1.27.0-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules that are referenced by replace directives
COPY ai/ ./ai/
COPY core/ ./core/
COPY orchestration/ ./orchestration/
COPY telemetry/ ./telemetry/
COPY resilience/ ./resilience/

# Copy the agent-with-async example
COPY examples/agent-with-async/ ./examples/agent-with-async/

WORKDIR /app/examples/agent-with-async

# Configure Go build
ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

# Download remaining dependencies and build
RUN go mod tidy && go mod download

# Build the binary with optimizations
ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o async-travel-agent .

# Verify the binary was created
RUN ls -lh async-travel-agent

# Runtime stage
FROM alpine:3.23

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Create non-root user for security (matches k8s securityContext runAsUser: 1001)
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Copy binary from builder stage
COPY --from=builder /app/examples/agent-with-async/async-travel-agent .

# Change ownership to non-root user
RUN chown appuser:appgroup /app/async-travel-agent && \
    chmod +x /app/async-travel-agent
USER appuser

# Set default PORT if not provided
ENV PORT=8098

# Expose port
EXPOSE ${PORT}

# Run the binary
ENTRYPOINT ["./async-travel-agent"]
