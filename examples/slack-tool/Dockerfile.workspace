# Workspace Dockerfile for slack-tool
# Builds with LOCAL modules (uses local core and telemetry)
# Usage (from truvag3 root): docker build -f examples/slack-tool/Dockerfile.workspace -t slack-tool:latest .

FROM golang:1.26.3-alpine AS builder

RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules referenced by replace directives
COPY core/ ./core/
COPY telemetry/ ./telemetry/

# Copy the slack-tool example
COPY examples/slack-tool/ ./examples/slack-tool/

WORKDIR /app/examples/slack-tool

ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

RUN go mod tidy && go mod download

ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o slack-tool .

RUN ls -lh slack-tool

# Runtime stage
FROM alpine:3.23

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

COPY --from=builder /app/examples/slack-tool/slack-tool .

RUN chown appuser:appgroup /app/slack-tool && \
    chmod +x /app/slack-tool
USER appuser

ENV PORT=8363

EXPOSE ${PORT}

ENTRYPOINT ["./slack-tool"]
