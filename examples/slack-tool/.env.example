# Slack Tool - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8373)
PORT=8373

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
# Set to "true" for local development
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Format: redis://[username:password@]host:port[/database]
# Examples:
#   - Local: redis://localhost:6379
#   - K8s: redis://redis-service.truvag3-examples.svc.cluster.local:6379
#   - Auth: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Application Configuration (REQUIRED)
# ==============================================================================

# Slack Bot OAuth Token (REQUIRED)
# Create a Slack app at: https://api.slack.com/apps
# Required Bot Token Scopes:
#   - chat:write          (send messages to channels the bot is in)
#   - chat:write.public   (send messages to any public channel)
#   - channels:read       (list channels and get channel info)
#   - search:read         (search messages in the workspace)
#
# Steps to get your token:
#   1. Go to https://api.slack.com/apps and click "Create New App"
#   2. Choose "From scratch", name it, pick your workspace
#   3. Go to "OAuth & Permissions" -> "Scopes" -> "Bot Token Scopes"
#   4. Add the 4 scopes listed above
#   5. Click "Install to Workspace" at the top
#   6. Copy the "Bot User OAuth Token" (starts with xoxb-)
SLACK_BOT_TOKEN=your-slack-bot-token-here

# Slack User OAuth Token (OPTIONAL — required for search_messages capability)
# Slack's search.messages API only works with user tokens (xoxp-), not bot tokens.
# Required User Token Scopes:
#   - search:read         (search messages in the workspace)
#
# To get your user token:
#   1. In your Slack app at https://api.slack.com/apps
#   2. Go to "OAuth & Permissions" -> "User Token Scopes"
#   3. Add the "search:read" scope
#   4. Click "Reinstall to Workspace" at the top
#   5. Copy the "User OAuth Token" (starts with xoxp-)
SLACK_USER_TOKEN=your-slack-user-token-here

# Optional: Default channel for testing (Slack channel ID, not name)
# Find channel ID: right-click channel in Slack -> "View channel details" -> scroll to bottom
SLACK_DEFAULT_CHANNEL=C123ABC456

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json for production)
# Use "text" for easier local development reading
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# Service name for K8s service discovery (default: derived from tool name)
TRUVAG3_K8S_SERVICE_NAME=slack-tool-service

# Pod name - automatically set by K8s (don't set manually)
# TRUVAG3_K8S_POD_NAME=slack-tool-xyz123

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# Application environment profile (default: development)
APP_ENV=development

# OpenTelemetry collector endpoint
# Format: http://host:port
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name for telemetry (default: slack-tool)
OTEL_SERVICE_NAME=slack-tool

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis-service.truvag3-examples.svc.cluster.local:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Create a Slack app and get your Bot Token:
#    - Visit: https://api.slack.com/apps
#    - Create a new app, add required scopes (see above)
#    - Install to your workspace
#    - Copy the Bot User OAuth Token
#    - Paste it in SLACK_BOT_TOKEN above
#
# 3. For local testing:
#    export $(cat .env | xargs)
#    go run .
#
# 4. For Kubernetes deployment:
#    Update the secret in k8-deployment.yaml with your bot token
#    ./setup.sh deploy
#
