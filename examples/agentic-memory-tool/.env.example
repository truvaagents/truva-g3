# Agentic Memory Tool - Environment Variables
# Copy this file to .env and fill in your values
#
# NOTE: No API keys required! This tool reads from shared memory backends (Redis/Qdrant).

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8377)
PORT=8377

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
# Set to "true" for local development
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Format: redis://[username:password@]host:port[/database]
# Examples:
#   - Local: redis://localhost:6379
#   - K8s: redis://redis-service.truvag3-examples.svc.cluster.local:6379
#   - Auth: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Memory Configuration
# ==============================================================================

# Domain scope for memory queries (default: infrastructure)
# All queries are scoped to this domain — matches the agents writing events.
TRUVAG3_AGENT_DOMAIN=infrastructure

# ==============================================================================
# Vector Search Configuration (Optional)
# ==============================================================================

# If not set, query_knowledge capability returns empty results (graceful degradation).

# Qdrant vector database URL
# In-cluster default: qdrant.truvag3-examples:6334
TRUVAG3_VECTOR_DB_URL=qdrant.truvag3-examples:6334

# Embedding endpoint (OpenAI-compatible API for vector search)
# For local Ollama: http://host.docker.internal:11434/v1
TRUVAG3_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1

# Embedding model name
TRUVAG3_EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json for production)
# Use "text" for easier local development reading
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# Service name for K8s service discovery (default: derived from tool name)
TRUVAG3_K8S_SERVICE_NAME=agentic-memory-tool-service

# Pod name - automatically set by K8s (don't set manually)
# TRUVAG3_K8S_POD_NAME=agentic-memory-tool-xyz123

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# Application environment profile (default: development)
APP_ENV=development

# OpenTelemetry collector endpoint
# Format: http://host:port
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name for telemetry (default: agentic-memory-tool)
OTEL_SERVICE_NAME=agentic-memory-tool

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis-service.truvag3-examples.svc.cluster.local:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. No API key needed! This tool reads from shared Redis/Qdrant backends.
#
# 3. For local testing (with port-forwarded Redis):
#    REDIS_URL=redis://localhost:6379 go run .
#
# 4. For Kubernetes deployment:
#    ./setup.sh deploy
#
