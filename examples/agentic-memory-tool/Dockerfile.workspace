# Workspace Dockerfile for agentic-memory-tool
# Usage (from truvag3 root): docker build -f examples/agentic-memory-tool/Dockerfile.workspace -t agentic-memory-tool:latest .

FROM golang:1.26.2-alpine AS builder

RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules referenced by replace directives
COPY core/ ./core/
COPY telemetry/ ./telemetry/
COPY memory/ ./memory/
COPY ai/ ./ai/

# Copy the tool
COPY examples/agentic-memory-tool/ ./examples/agentic-memory-tool/

WORKDIR /app/examples/agentic-memory-tool

# Configure Go build
ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

# Download remaining dependencies and build
RUN go mod tidy && go mod download

# Build the binary with optimizations
ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o agentic-memory-tool .

FROM alpine:3.23
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

COPY --from=builder /app/examples/agentic-memory-tool/agentic-memory-tool .
RUN chown appuser:appgroup /app/agentic-memory-tool && \
    chmod +x /app/agentic-memory-tool
USER appuser

ENV PORT=8377
EXPOSE ${PORT}
ENTRYPOINT ["./agentic-memory-tool"]
