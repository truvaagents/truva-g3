# Confluence Tool - Environment Variables
# Copy this file to .env and fill in your values
#
# NOTE: Uses the same Atlassian API token as the JIRA tool.

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8376)
PORT=8376

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
# Set to "true" for local development
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Format: redis://[username:password@]host:port[/database]
# Examples:
#   - Local: redis://localhost:6379
#   - K8s: redis://redis-service.truvag3-examples.svc.cluster.local:6379
#   - Auth: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Application Configuration (REQUIRED)
# ==============================================================================

# Confluence Base URL (REQUIRED)
# Your Atlassian Cloud instance URL
# Example: https://mycompany.atlassian.net
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net

# Confluence User Email (REQUIRED)
# The email address associated with your Atlassian account
CONFLUENCE_USER_EMAIL=your-email@example.com

# Confluence API Token (REQUIRED)
# Same Atlassian API token used for JIRA
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
#
# Steps to get your token:
#   1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Click "Create API token"
#   3. Give it a label (e.g., "TruvaG3 Confluence Tool")
#   4. Copy the generated token
#
# NOTE: This is the same token type used by the jira-tool.
# If you already have a JIRA API token, you can reuse it.
CONFLUENCE_API_TOKEN=your_api_token_here

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json for production)
# Use "text" for easier local development reading
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# Service name for K8s service discovery (default: derived from tool name)
TRUVAG3_K8S_SERVICE_NAME=confluence-service

# Pod name - automatically set by K8s (don't set manually)
# TRUVAG3_K8S_POD_NAME=confluence-tool-xyz123

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# Application environment profile (default: development)
APP_ENV=development

# OpenTelemetry collector endpoint
# Format: http://host:port
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name for telemetry (default: confluence)
OTEL_SERVICE_NAME=confluence-tool

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis-service.truvag3-examples.svc.cluster.local:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Set your Confluence credentials:
#    - CONFLUENCE_BASE_URL: Your Atlassian instance URL
#    - CONFLUENCE_USER_EMAIL: Your Atlassian account email
#    - CONFLUENCE_API_TOKEN: API token from id.atlassian.com
#    (Same token type as JIRA - you can reuse an existing one)
#
# 3. For local testing:
#    export $(cat .env | xargs)
#    go run .
#
# 4. For Kubernetes deployment:
#    ./setup.sh deploy
#
