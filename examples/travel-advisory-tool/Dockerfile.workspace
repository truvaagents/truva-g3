# Workspace Dockerfile for travel-advisory-tool
FROM golang:1.26.4-alpine AS builder
RUN apk add --no-cache git make gcc musl-dev ca-certificates
WORKDIR /app
COPY core/ ./core/
COPY telemetry/ ./telemetry/
COPY examples/travel-advisory-tool/ ./examples/travel-advisory-tool/
WORKDIR /app/examples/travel-advisory-tool
ENV GOWORK=off CGO_ENABLED=0 GOOS=linux GONOSUMDB=github.com/truvaagents/truva-g3/*
RUN go mod tidy && go mod download
ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo -ldflags '-w -s -extldflags "-static"' -o travel-advisory-tool .
FROM alpine:3.23
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
RUN addgroup -g 1001 -S appgroup && adduser -u 1001 -S appuser -G appgroup
COPY --from=builder /app/examples/travel-advisory-tool/travel-advisory-tool .
RUN chown appuser:appgroup /app/travel-advisory-tool && chmod +x /app/travel-advisory-tool
USER appuser
ENV PORT=8345
EXPOSE ${PORT}
ENTRYPOINT ["./travel-advisory-tool"]
