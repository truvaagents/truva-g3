# Economic Data Tool Configuration
REDIS_URL=redis://localhost:6379
PORT=8363
NAMESPACE=truvag3-examples
APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEV_MODE=true

# FRED API key (free signup at https://fred.stlouisfed.org/docs/api/api_key.html)
# Required for live data - API calls will fail without a key
FRED_API_KEY=your_api_key_here

# Optional logging configuration
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
