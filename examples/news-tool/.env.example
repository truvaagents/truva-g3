# News Tool Configuration
# Redis / Valkey connection overrides
# Local execution defaults to standalone DB 0 at localhost:6379. Kubernetes
# manifests provide the in-cluster standalone URL. Uncomment only to override.
# REDIS_URL=redis://localhost:6379/0
#
# Cluster alternative. Never set this together with REDIS_URL.
# For Kubernetes, prefer k8-deployment/setup-redis-cluster-validation.sh so the
# URL shorthand is cleared before these structured settings are applied.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default
PORT=8099
APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEV_MODE=true

# Required: Get a free API key at https://gnews.io/
GNEWS_API_KEY=your_api_key_here
