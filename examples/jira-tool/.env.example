# JIRA Tool - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8366)
PORT=8366

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
# Set to "true" for local development
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Format: redis://[username:password@]host:port[/0] (DB 0 only)
# Examples:
#   - Local: redis://localhost:6379
#   - K8s: redis://redis-service.truvag3-examples.svc.cluster.local:6379
#   - Auth: redis://:password@localhost:6379
# Redis / Valkey connection overrides
# Local execution defaults to standalone DB 0 at localhost:6379. Kubernetes
# manifests provide the in-cluster standalone URL. Uncomment only to override.
# REDIS_URL=redis://localhost:6379/0
#
# Cluster alternative. Never set this together with REDIS_URL.
# For Kubernetes, prefer k8-deployment/setup-redis-cluster-validation.sh so the
# URL shorthand is cleared before these structured settings are applied.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default

# ==============================================================================
# JIRA Configuration (REQUIRED)
# ==============================================================================

# JIRA Cloud instance URL
# Format: https://your-domain.atlassian.net
JIRA_BASE_URL=https://mycompany.atlassian.net

# Atlassian account email for API authentication
JIRA_USER_EMAIL=user@example.com

# JIRA API token for authentication
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json for production)
# Use "text" for easier local development reading
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# Service name for K8s service discovery (default: derived from tool name)
TRUVAG3_K8S_SERVICE_NAME=jira-tool-service

# Pod name - automatically set by K8s (don't set manually)
# TRUVAG3_K8S_POD_NAME=jira-tool-xyz123

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# Application environment: development, staging, production
APP_ENV=development

# OpenTelemetry collector endpoint
# Format: http://host:port
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name for telemetry (default: jira-tool)
OTEL_SERVICE_NAME=jira-tool

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis-service.truvag3-examples.svc.cluster.local:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text
#
# To send telemetry to the OTel collector running in Kind:
#   kubectl port-forward -n truvag3-examples svc/otel-collector 4318:4318
# Then set:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get your JIRA API token:
#    - Visit: https://id.atlassian.com/manage-profile/security/api-tokens
#    - Click "Create API token"
#    - Copy the token and paste it in JIRA_API_TOKEN above
#    - Set JIRA_BASE_URL to your Atlassian instance URL
#    - Set JIRA_USER_EMAIL to your Atlassian account email
#
# 3. For local testing:
#    export $(cat .env | xargs)
#    go run .
#
# 4. For Kubernetes deployment:
#    ./setup.sh full-deploy
#
