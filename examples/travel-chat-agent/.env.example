# =============================================================================
# Travel Chat Agent with Orchestration - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# This agent uses CHAIN CLIENT for production-grade resilience:
#   - Automatic failover: OpenAI -> Anthropic -> OpenRouter -> Gemini -> Groq
#   - If OpenAI fails (rate limit, outage), automatically tries Anthropic
#   - If Anthropic fails, it continues through the remaining configured providers
#   - You only need ONE provider configured, but more = better resilience
# =============================================================================

# =============================================================================
# Setup-Only Skill Synchronization (Optional)
# =============================================================================
# The setup script warns and continues if automatic skill synchronization
# fails. Use another Skills API address when registry.localhost is not routed
# from this host, or skip only the automatic attempt. Explicit skills-sync and
# skills-check commands remain strict.
#TRUVAG3_SKILLS_API_URL=http://registry.localhost/api/v1/skills
#TRUVAG3_SKIP_SKILLS_SYNC=true

# =============================================================================
# AI Provider API Keys (Chain Client: OpenAI -> Anthropic -> OpenRouter -> Gemini -> Groq)
# =============================================================================
# The agent tries providers in order until one succeeds.
# Configure multiple providers for high availability.
#
# Priority order:
#   1. OpenAI (primary) - Best quality, most features
#   2. Anthropic (fallback) - Excellent reasoning, different strengths
#   3. OpenRouter - Unified access to hosted and free model routes
#   4. Gemini - Multimodal Google models
#   5. Groq - Ultra-fast, generous free tier

# OpenAI - Primary Provider (RECOMMENDED)
# Get your key: https://platform.openai.com/api-keys
# Pricing: https://openai.com/pricing
OPENAI_API_KEY=

# Anthropic - Second Priority (Claude models)
# Get your key: https://console.anthropic.com/
# Pricing: https://www.anthropic.com/pricing
#ANTHROPIC_API_KEY=

# OpenRouter - Third Priority (unified model routing)
# Get your key: https://openrouter.ai/settings/keys
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq - Later Fallback (Ultra-fast inference)
# Get your key: https://console.groq.com/keys
# Free tier: 14,000 tokens/minute - great for development!
GROQ_API_KEY=

# Google Gemini - Alternative Provider
# Get your key: https://aistudio.google.com/apikey
#GEMINI_API_KEY=

# =============================================================================
# OpenAI-Compatible Providers (Alternative to OpenAI)
# =============================================================================
# You can use any OpenAI-compatible API by setting OPENAI_BASE_URL.
# This allows using providers like DeepSeek, Together AI, local Ollama, etc.
# as a drop-in replacement for OpenAI.
#
# Option 1: Override OPENAI_BASE_URL (puts your DeepSeek/etc. key into OPENAI_API_KEY
# above, then points the base URL at the alternate provider)
#   OPENAI_API_KEY=
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   TRUVAG3_OPENAI_MODEL_DEFAULT=deepseek-chat
#
# Option 2: Use dedicated environment variables (provider-specific)
#   These are auto-configured when using provider aliases in code.

# DeepSeek - High quality, cost-effective
# Get your key: https://platform.deepseek.com/
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com  # (default, can be omitted)

# xAI (Grok) - Elon Musk's AI
# Get your key: https://console.x.ai/
#XAI_API_KEY=
#XAI_BASE_URL=https://api.x.ai/v1  # (default, can be omitted)

# Together AI - Many open source models
# Get your key: https://api.together.ai/
#TOGETHER_API_KEY=
#TOGETHER_BASE_URL=https://api.together.ai/v1  # (default, can be omitted)

# Qwen (Alibaba) - Excellent multilingual support
# Get your key: https://dashscope.console.aliyun.com/
#QWEN_API_KEY=
#QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  # (default)

# Ollama - Local models (no API key needed)
# Install: https://ollama.ai/
#OLLAMA_BASE_URL=http://localhost:11434/v1  # (default, can be omitted)

# =============================================================================
# Model Alias Overrides (Optional)
# =============================================================================
# Override which model is used for each "alias" without changing code.
# Pattern: TRUVAG3_{PROVIDER}_MODEL_{ALIAS}=actual-model-name
#
# Aliases:
#   - "default": General use, balanced cost/quality
#   - "smart": Best reasoning quality
#   - "fast": Speed and cost optimized
#
# Example: Use cheaper models in development
TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-5.6-terra
TRUVAG3_OPENAI_MODEL_FAST=gpt-5.6-luna
TRUVAG3_OPENAI_MODEL_SMART=gpt-5.6-sol
#TRUVAG3_ANTHROPIC_MODEL_DEFAULT=claude-3-haiku-20240307
# The built-in OpenRouter default is openrouter/auto. Pin a concrete default
# instead when deterministic model identity/cache eligibility matters:
#TRUVAG3_OPENROUTER_MODEL_DEFAULT=openai/gpt-5.6-sol
# Each alias can be overridden independently; uncomment only what you need:
#TRUVAG3_OPENROUTER_MODEL_SMART=moonshotai/kimi-k3
#TRUVAG3_OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
#TRUVAG3_OPENROUTER_MODEL_CODE=moonshotai/kimi-k3
# Exact :free routes are experimental; no built-in OpenRouter free alias is advertised.
#TRUVAG3_GROQ_MODEL_DEFAULT=llama-3.1-8b-instant

# =============================================================================
# Service Configuration
# =============================================================================

# Redis URL for service discovery (required)
REDIS_URL=redis://localhost:6379

# HTTP server port (matches setup.sh, k8-deployment.yaml, examples/README.md)
PORT=8356

# Development mode - enables verbose logging
DEV_MODE=true

# CORS: Allow X-User-ID header from chat-ui frontend
TRUVAG3_CORS_HEADERS=Content-Type,Authorization,X-User-ID,X-Requested-With

# =============================================================================
# Orchestration Configuration (Optional)
# =============================================================================
# These control how the agent orchestrates tool calls and workflows.

# Orchestrator mode: autonomous or workflow
TRUVAG3_ORCHESTRATOR_MODE=autonomous

# Number of tools to consider for each step
#TRUVAG3_CAPABILITY_TOP_K=20

# Similarity threshold for tool matching (0.0-1.0)
#TRUVAG3_CAPABILITY_THRESHOLD=0.7

# Maximum number of iterative planning phases per request (default: 5).
TRUVAG3_ITERATIVE_MAX_PHASES=8

# =============================================================================
# Orchestration Model Overrides (Per-Phase LLM Model Selection)
# =============================================================================
# Route each orchestration phase to a different model tier for cost/latency
# optimization. Use portable aliases ("fast", "default", "smart") when using
# ChainClient for cross-provider failover compatibility.
#
# Empty string (default) = use AIClient's default model.
# See: docs/AI_PROVIDERS_SETUP_GUIDE.md → "Orchestration Model Overrides"

# Plan generation — best reasoning for complex multi-tool plans
#TRUVAG3_PLAN_MODEL=smart

# Response synthesis — balanced quality for user-facing answers
#TRUVAG3_SYNTHESIS_MODEL=default

# Micro-resolution & semantic retry — fast/cheap for parameter extraction
#TRUVAG3_MICRO_RESOLUTION_MODEL=fast

# Result distillation — fast/cheap for summarizing large tool responses
#TRUVAG3_RESULT_DISTILL_MODEL=fast

# =============================================================================
# Semantic Retry Configuration (Layer 4: Contextual Re-Resolution)
# =============================================================================
# When a tool call fails with validation error (400/422), the semantic retry
# system uses LLM to re-compute parameters based on execution context.
#
# Example: "sell 100 TSLA shares and convert to KRW"
#   - get_stock_quote(TSLA) returns {price: 468.285}
#   - convert_currency(amount: 0) fails with "amount must be > 0"
#   - Semantic retry: LLM computes 100 * 468.285 = 46828.5 and retries

#TRUVAG3_SEMANTIC_RETRY_ENABLED=true
#TRUVAG3_SEMANTIC_RETRY_MAX_ATTEMPTS=2

# =============================================================================
# LLM Debug Payload Store (Production Debugging)
# =============================================================================
# Captures complete LLM prompts and responses for debugging orchestration issues.
# Unlike Jaeger spans which truncate large payloads, this stores the full content.
#
# Recording sites: plan_generation, correction, synthesis, synthesis_streaming,
#                  micro_resolution, semantic_retry
#
# See: orchestration/notes/LLM_DEBUG_PAYLOAD_DESIGN.md

# Enable LLM debug capture (default: false)
TRUVAG3_LLM_DEBUG_ENABLED=true

# TTL for successful records (default: 24h)
#TRUVAG3_LLM_DEBUG_TTL=24h

# TTL for error records - longer for debugging (default: 168h / 7 days)
#TRUVAG3_LLM_DEBUG_ERROR_TTL=168h

# Redis database index for debug storage (default: 7)
#TRUVAG3_LLM_DEBUG_REDIS_DB=7

# =============================================================================
# Telemetry Configuration (Optional)
# =============================================================================
# APP_ENV selects the telemetry profile:
#   - development: Console output, high verbosity, all traces
#   - staging: OTLP export, medium verbosity, sampled traces
#   - production: OTLP export, low verbosity, sampled traces

APP_ENV=development

# OpenTelemetry endpoint for distributed tracing
# In Kubernetes: http://otel-collector.truvag3-examples.svc.cluster.local:4318
# Local with port-forward: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# Logging Configuration (Optional)
# =============================================================================
# TRUVAG3_LOG_LEVEL: debug, info, warn, error
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json

# Alternative debug flag
TRUVAG3_DEBUG=true

# Payload schema validation (framework-level)
TRUVAG3_VALIDATE_PAYLOADS=false

# Execution Debug Store (stores orchestration DAGs in Redis DB 8)
# View in Registry Viewer: http://localhost:8361 -> Execution DAG tab
TRUVAG3_EXECUTION_DEBUG_STORE_ENABLED=true

# =============================================================================
# Synthesis Configuration
# =============================================================================
# Max output tokens for LLM synthesis (default: 5000)
TRUVAG3_SYNTHESIS_MAX_TOKENS=10000

# =============================================================================
# Result Trimming (Large Data Management)
# =============================================================================
# Cap tool-result size so a single large response (e.g., long search payload)
# doesn't blow the synthesis prompt's token budget. Values are in bytes.
TRUVAG3_RESULT_TRIM_MAX_BYTES=65536
TRUVAG3_RESULT_TRIM_MAX_TOTAL_BYTES=100000

# =============================================================================
# Timeouts (browser tests + multi-tool orchestration need longer windows)
# =============================================================================
TRUVAG3_ITERATIVE_PHASE_TIMEOUT=5m
TRUVAG3_ORCHESTRATION_TIMEOUT=15m
TRUVAG3_HTTP_WRITE_TIMEOUT=15m
TRUVAG3_HTTP_READ_TIMEOUT=15m

# Service-discovery heartbeat interval (framework default: 15s).
# Shorter heartbeats detect dead services faster in local dev.
TRUVAG3_DISCOVERY_HEARTBEAT=10s

# =============================================================================
# Shared Agent Memory (Optional)
# =============================================================================
# Domain groups agents for memory scoping — agents in the same domain
# see each other's episodic events and coordination signals.
#
# NOTE: travel-chat-agent only wires user memory (BuildUserMemoryHooks),
# not shared episodic memory (BuildMemoryHooks). Setting this has no
# observable effect today — leave it commented unless you've wired
# SharedBackends in main.go.
#TRUVAG3_AGENT_DOMAIN=travel

# Vector DB for shared knowledge and user memory (Qdrant)
# Set TRUVAG3_DEPLOY_QDRANT=true in setup.sh to auto-deploy Qdrant in the cluster.
TRUVAG3_DEPLOY_QDRANT=true
TRUVAG3_VECTOR_DB_URL=qdrant.truvag3-examples:6334

# Embedding endpoint (Ollama running locally, exposed to cluster via host.docker.internal)
TRUVAG3_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
TRUVAG3_EMBEDDING_MODEL=nomic-embed-text

# Shared memory summarizer model — feeds both the event summarizer and the
# activity compactor. "fast" routes to each provider's cheap/quick alias.
TRUVAG3_SHARED_MEMORY_SUMMARIZER_MODEL=fast

# =============================================================================
# User Memory Configuration (Optional — requires Vector DB + Embedding above)
# =============================================================================
# Per-user private memory for personalized responses. Facts are extracted
# from conversations and recalled in future sessions via <user_profile> tag.
# Only active when Vector DB and Embedding are configured above.
#
# Collection name for user facts (separate from shared knowledge)
#TRUVAG3_USER_MEMORY_COLLECTION=truvag3_user_memory
#
# Max facts injected into planning prompt (default: 15)
#TRUVAG3_USER_MEMORY_MAX_FACTS_IN_PROMPT=15
#
# Model for fact extraction LLM calls (default: agent's default model)
# Use a fast/cheap model — these are high-volume, low-complexity calls.
#TRUVAG3_USER_MEMORY_EXTRACTION_MODEL=fast
