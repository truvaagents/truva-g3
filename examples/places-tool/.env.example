# Places Tool - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8344)
PORT=8344

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
# Set to "true" for local development
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Format: redis://[username:password@]host:port[/database]
# Examples:
#   - Local: redis://localhost:6379
#   - K8s: redis://redis-service.truvag3-examples.svc.cluster.local:6379
#   - Auth: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Places API Configuration (at least one provider REQUIRED)
# ==============================================================================

# Foursquare Places API v3 key
# Get your FREE API key from: https://foursquare.com/developers/signup
# Free tier includes:
#   - 10,000 regular API calls/month
#   - Place search, details, and nearby
#   - Rich category data, brand/chain info
FOURSQUARE_API_KEY=your-foursquare-api-key-here

# Geoapify Places API key
# Get your FREE API key from: https://myprojects.geoapify.com/register
# Free tier includes:
#   - ~3,000 requests/day (~90,000/month)
#   - Place search, details, and nearby
#   - Rich POI data with categories
GEOAPIFY_API_KEY=your-geoapify-api-key-here

# Default places provider: foursquare or geoapify (default: foursquare)
# Can be overridden per-request via the "provider" field
PLACES_DEFAULT_PROVIDER=foursquare

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# Application environment for telemetry profile selection
# Values: development (100% sampling), staging (10%), production (0.1%)
APP_ENV=development

# OpenTelemetry collector endpoint
# Format: http://host:port
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for telemetry (default: places-service)
OTEL_SERVICE_NAME=places-service

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json for production)
# Use "text" for easier local development reading
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# Service name for K8s service discovery (default: derived from tool name)
TRUVAG3_K8S_SERVICE_NAME=places-service

# Pod name - automatically set by K8s (don't set manually)
# TRUVAG3_K8S_POD_NAME=places-service-xyz123

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis-service.truvag3-examples.svc.cluster.local:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get at least one places API key:
#
#    Foursquare (recommended primary):
#    - Visit: https://foursquare.com/developers/signup
#    - Create a project and copy the API key
#    - Paste it in FOURSQUARE_API_KEY above
#
#    Geoapify (recommended fallback):
#    - Visit: https://myprojects.geoapify.com/register
#    - Create a project and copy the API key
#    - Paste it in GEOAPIFY_API_KEY above
#
# 3. For local testing:
#    export $(cat .env | xargs)
#    go run .
#
# 4. For Kubernetes deployment:
#    Update the secret in k8-deployment.yaml with your API keys
#
