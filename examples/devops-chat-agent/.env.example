# =============================================================================
# DevOps Chat Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# This agent uses CHAIN CLIENT for production-grade resilience:
#   - Automatic failover: OpenAI -> Anthropic -> Groq
#   - If OpenAI fails (rate limit, outage), automatically tries Anthropic
#   - If Anthropic fails, falls back to Groq
#   - You only need ONE provider configured, but more = better resilience
# =============================================================================

# =============================================================================
# AI Provider API Keys (Chain Client: OpenAI -> Anthropic -> Groq)
# =============================================================================
# The agent tries providers in order until one succeeds.
# Configure multiple providers for high availability.

# OpenAI - Primary Provider (RECOMMENDED)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - First Fallback (Claude models)
# Get your key: https://console.anthropic.com/
#ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Groq - Final Fallback (Ultra-fast inference)
# Get your key: https://console.groq.com/keys
#GROQ_API_KEY=gsk-your-groq-key-here

# Google Gemini - Alternative Provider
# Get your key: https://aistudio.google.com/apikey
#GEMINI_API_KEY=your-gemini-key-here

# =============================================================================
# OpenAI-Compatible Providers (Alternative to OpenAI)
# =============================================================================
# DeepSeek - High quality, cost-effective
#DEEPSEEK_API_KEY=your-deepseek-key-here

# xAI (Grok)
#XAI_API_KEY=your-xai-key-here

# Together AI - Many open source models
#TOGETHER_API_KEY=your-together-key-here

# Qwen (Alibaba) - Excellent multilingual support
#QWEN_API_KEY=your-qwen-key-here

# Mistral
#MISTRAL_API_KEY=your-mistral-key-here

# =============================================================================
# Model Alias Overrides (Optional)
# =============================================================================
# Override which model is used for each "alias" without changing code.
# Pattern: TRUVAG3_{PROVIDER}_MODEL_{ALIAS}=actual-model-name
TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-4.1-2025-04-14
#TRUVAG3_OPENAI_MODEL_SMART=gpt-4o
#TRUVAG3_ANTHROPIC_MODEL_DEFAULT=claude-3-haiku-20240307

# =============================================================================
# Service Configuration
# =============================================================================

# Redis URL for service discovery and session storage (required)
REDIS_URL=redis://localhost:6379

# HTTP server port
PORT=8357

# Development mode - enables verbose logging
DEV_MODE=false

# CORS: Allow X-User-ID header from chat-ui frontend
TRUVAG3_CORS_HEADERS=Content-Type,Authorization,X-User-ID,X-Requested-With

# =============================================================================
# HTTP Server Timeouts
# =============================================================================
# Sync chat agents that run multi-phase orchestration must override the
# framework defaults (30s read / 30s write). The HTTP server's WriteTimeout
# is the deadline for completing the response write — any handler that takes
# longer than WriteTimeout will have its connection killed by Go's HTTP server,
# even if the handler is still doing useful work.
#
# This matters when other agents delegate to devops-chat-agent (e.g.,
# event-driven-agent calling devops_operations). Without these overrides,
# inbound delegations fail with EOF after the framework default 30s, even
# though devops-chat-agent successfully completes the work.
#
# WriteTimeout (15m) covers worst-case orchestration: 5 phases × ~2min/phase
# + streaming synthesis + headroom.
TRUVAG3_HTTP_READ_TIMEOUT=2m
TRUVAG3_HTTP_WRITE_TIMEOUT=15m

# =============================================================================
# Orchestration Configuration
# =============================================================================
# Outbound HTTP client timeout (for tool/sub-agent calls). Must be >= the
# longest single sub-call this agent makes. Aligned with HTTP_WRITE_TIMEOUT
# so outbound calls don't die before the inbound handler does.
TRUVAG3_ORCHESTRATION_TIMEOUT=15m

# Per-step deadline. Each individual tool/sub-agent call must complete within
# this duration. Most calls take seconds; 5min is for slow LLM-backed tools.
TRUVAG3_EXECUTION_STEP_TIMEOUT=5m

# Per-phase deadline (one plan generation + parallel execution of all steps).
TRUVAG3_ITERATIVE_PHASE_TIMEOUT=10m

# Maximum number of iterative planning phases per request (default: 5).
TRUVAG3_ITERATIVE_MAX_PHASES=8

#TRUVAG3_ORCHESTRATOR_MODE=autonomous
#TRUVAG3_CAPABILITY_TOP_K=20
#TRUVAG3_CAPABILITY_THRESHOLD=0.7

# =============================================================================
# HITL (Human-in-the-Loop) Configuration
# =============================================================================
# Step-level only — plan-level would block read-only queries.
# STEP_SENSITIVE_CAPABILITIES: comma-separated capability names that trigger
# an approval prompt before execution. Edit this list to add/remove guarded ops.
# DEFAULT_ACTION on timeout: "reject" (safe default) or "approve".
TRUVAG3_HITL_ENABLED=true
TRUVAG3_HITL_STEP_SENSITIVE_CAPABILITIES=rollout_restart,scale_deployment,delete_pod,kubectl_command
TRUVAG3_HITL_DEFAULT_TIMEOUT=5m
TRUVAG3_HITL_DEFAULT_ACTION=reject
TRUVAG3_HITL_WEBHOOK_URL=http://devops-chat-agent-service.truvag3-examples/internal/hitl-webhook
# Disable on-error escalation: 0 = never escalate, propagate the underlying
# error directly to the user. (Framework default is 3, which would create an
# expired-checkpoint dead-end here because no UI surfaces on_error HITL.)
TRUVAG3_HITL_ESCALATE_AFTER_RETRIES=0

# =============================================================================
# Semantic Retry Configuration (Layer 4: Contextual Re-Resolution)
# =============================================================================
#TRUVAG3_SEMANTIC_RETRY_ENABLED=true
#TRUVAG3_SEMANTIC_RETRY_MAX_ATTEMPTS=2

# =============================================================================
# LLM Debug Payload Store (Production Debugging)
# =============================================================================
TRUVAG3_LLM_DEBUG_ENABLED=true
#TRUVAG3_LLM_DEBUG_TTL=24h
#TRUVAG3_LLM_DEBUG_ERROR_TTL=168h

# =============================================================================
# Logging Configuration
# =============================================================================
#TRUVAG3_LOG_LEVEL=info
#TRUVAG3_DEBUG=true

# =============================================================================
# Synthesis Configuration
# =============================================================================
# Max output tokens for LLM synthesis (default: 5000)
TRUVAG3_SYNTHESIS_MAX_TOKENS=10000

# =============================================================================
# Execution Debug Store (stores orchestration DAGs in Redis DB 8)
# =============================================================================
# View in Registry Viewer: http://localhost:8361 -> Execution DAG tab
TRUVAG3_EXECUTION_DEBUG_STORE_ENABLED=true

# =============================================================================
# Result Trimming (Large Data Management)
# =============================================================================
# DevOps tools return large responses (kubectl get pods -o json can be 500KB+).
# Increase trim budgets so pod logs and resource details are not dropped.
# Values are in bytes (not KB).
TRUVAG3_RESULT_TRIM_MAX_BYTES=65536
TRUVAG3_RESULT_TRIM_MAX_TOTAL_BYTES=131072

# =============================================================================
# Shared Agent Memory (Cross-Agent Episodic Events + Vector Knowledge)
# =============================================================================
# Domain groups agents that share memory. Agents in the same domain see each
# other's episodic events and investigation claims.
TRUVAG3_AGENT_DOMAIN=infrastructure

# Deploy Qdrant vector DB during infrastructure setup (setup.sh full-deploy / infra)
# Set to true to enable semantic knowledge search across agents.
# Agents degrade gracefully without it (episodic memory still works via Redis).
TRUVAG3_DEPLOY_QDRANT=true

# Vector DB for semantic knowledge search (Phase 2)
# Local Kind: qdrant.truvag3-examples:6334 | Local dev: localhost:6334
TRUVAG3_VECTOR_DB_URL=qdrant.truvag3-examples:6334
#TRUVAG3_VECTOR_DB_COLLECTION=truvag3_knowledge
#TRUVAG3_VECTOR_DB_VECTOR_SIZE=768

# Embedding endpoint for knowledge extraction and semantic search
# Local Kind (Ollama on host Mac): http://host.docker.internal:11434/v1
# Local dev: http://localhost:11434/v1
# OpenAI: https://api.openai.com/v1 (set TRUVAG3_EMBEDDING_API_KEY, TRUVAG3_VECTOR_DB_VECTOR_SIZE=1536)
TRUVAG3_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
TRUVAG3_EMBEDDING_MODEL=nomic-embed-text
#TRUVAG3_EMBEDDING_API_KEY=

# =============================================================================
# Reflection Job — Long-Term Knowledge Retention (Tier 2 → Tier 3)
# =============================================================================
# The reflection job runs periodically, extracts patterns from old episodic
# events via an LLM call, and stores them as durable knowledge fragments in
# Qdrant. Fragments are recalled by semantic search and injected into
# <agent_memory> on future requests.
#
# Requires Phase 2 backends: TRUVAG3_VECTOR_DB_URL + TRUVAG3_EMBEDDING_BASE_URL.
#
# See: docs/AGENT_MEMORY_USER_GUIDE.md#long-term-knowledge-retention-the-reflection-job

# How often the reflection pass runs (default: 24h)
#TRUVAG3_REFLECTION_INTERVAL=24h

# Only events older than this are eligible (default: 168h / 7 days)
# Should be longer than the activity compactor's 24h window.
#TRUVAG3_REFLECTION_AGE_THRESHOLD=168h

# Min events per entity required to trigger reflection (default: 5)
# Lower = capture sparser entities; higher = more confident fragments
#TRUVAG3_REFLECTION_MIN_EVENTS=5

# Model for the reflection LLM call (default: agent's main model)
# Use a cheap/fast alias to reduce per-pass cost at the trade-off of slightly
# more generic patterns. Reflection writes durable knowledge that influences
# every future request, so this is a real cost-vs-quality choice — see
# docs/AGENT_MEMORY_USER_GUIDE.md for the decision matrix.
# Accepts: "fast" | "smart" | "default" | a concrete provider-specific model name.
TRUVAG3_REFLECTION_MODEL=fast

# =============================================================================
# Telemetry Configuration (Optional)
# =============================================================================
APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
