# =============================================================================
# Agent with Human Approval (HITL) - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# This agent demonstrates Human-in-the-Loop (HITL) for AI orchestration.
# HITL is ALWAYS enabled - all execution plans require human approval.
#
# AI Provider: Uses CHAIN CLIENT for production-grade resilience:
#   - Automatic failover: OpenAI -> Anthropic -> Groq
#   - If OpenAI fails, automatically tries Anthropic, then Groq
#   - Configure multiple providers for high availability
# =============================================================================

# =============================================================================
# AI Provider API Keys (Chain Client: OpenAI -> Anthropic -> Groq)
# =============================================================================
# The agent tries providers in order until one succeeds.
# Configure multiple providers for high availability.

# OpenAI - Primary Provider (RECOMMENDED)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - First Fallback (Claude models)
# Get your key: https://console.anthropic.com/
#ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Groq - Final Fallback (Ultra-fast inference)
# Get your key: https://console.groq.com/keys
#GROQ_API_KEY=gsk-your-groq-key-here

# Google Gemini - Alternative Provider
# Get your key: https://aistudio.google.com/apikey
#GEMINI_API_KEY=your-gemini-key-here

# =============================================================================
# Model Alias Overrides (Optional)
# =============================================================================
# Override which model is used for each "alias" without changing code.
TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-4.1-2025-04-14
#TRUVAG3_OPENAI_MODEL_SMART=gpt-4o
#TRUVAG3_ANTHROPIC_MODEL_DEFAULT=claude-3-haiku-20240307

# =============================================================================
# Service Configuration (Required)
# =============================================================================

# Redis URL for service discovery, sessions, and HITL checkpoints (REQUIRED)
REDIS_URL=redis://localhost:6379

# HTTP server port (default: 8098)
PORT=8098

# Namespace for service discovery
NAMESPACE=default

# =============================================================================
# HITL (Human-in-the-Loop) Configuration
# =============================================================================
# All HITL config is read from environment variables via orchestration.DefaultConfig()
# See orchestration/HUMAN_IN_THE_LOOP_PROPOSAL.md for full reference.
#
# HITL supports 4 scenarios:
#   Scenario 1: Plan Approval - Approve the execution plan before any tools run
#   Scenario 2: Step Approval - Approve individual tool calls with resolved parameters
#   Scenario 3: Output Validation - Validate tool outputs before continuing
#   Scenario 4: Error Escalation - Human intervention on repeated failures
#
# This configuration demonstrates Scenarios 1 and 2.

# Enable HITL globally (default: false)
TRUVAG3_HITL_ENABLED=true

# Agent identity — scopes the HITL checkpoint store's Redis key prefix to this
# agent (truvag3:hitl:<agent_name>:pending). Required when running multiple
# HITL-enabled agents against the same Redis; without it they share
# truvag3:hitl:pending and the registry viewer's HITL list will duplicate.
# Change the value if you rename this agent or run multiple instances.
TRUVAG3_AGENT_NAME=agent-with-human-approval

# -----------------------------------------------------------------------------
# Scenario 1: Plan Approval
# -----------------------------------------------------------------------------
# Require approval for ALL plans before execution begins.
# Set to true to see the "Plan Approval Required" dialog.
TRUVAG3_HITL_REQUIRE_PLAN_APPROVAL=true

# -----------------------------------------------------------------------------
# Scenario 2: Step Approval (with Resolved Parameters)
# -----------------------------------------------------------------------------
# There are TWO ways to configure step-level approval:
#
# Option A: SENSITIVE_CAPABILITIES (triggers BOTH plan AND step approval)
#   - Use when you want double-confirmation for critical operations
#   - Plan approval shows the overall plan
#   - Step approval shows resolved parameters (e.g., amount: 15000)
#
# Option B: STEP_SENSITIVE_CAPABILITIES (triggers ONLY step approval)
#   - Use with REQUIRE_PLAN_APPROVAL=true to avoid double-approval
#   - Plan approval covers all requests
#   - Step approval adds per-tool confirmation with parameters

# Option A: Capabilities that trigger BOTH plan and step approval
# (Comment out if using REQUIRE_PLAN_APPROVAL + STEP_SENSITIVE_CAPABILITIES)
#TRUVAG3_HITL_SENSITIVE_CAPABILITIES=stock_quote,company_profile

# Option B: Capabilities that trigger ONLY step approval (recommended with REQUIRE_PLAN_APPROVAL=true)
# These show resolved parameters like {symbol: "AAPL", quantity: 100}
TRUVAG3_HITL_STEP_SENSITIVE_CAPABILITIES=stock_quote,company_profile,company_news,market_news

# Agent-level equivalents (use agent names instead of capabilities)
#TRUVAG3_HITL_SENSITIVE_AGENTS=payment-service,trading-service
#TRUVAG3_HITL_STEP_SENSITIVE_AGENTS=stock-market-tool

# -----------------------------------------------------------------------------
# Demo Configuration Summary
# -----------------------------------------------------------------------------
# With the above settings:
#   1. ALL plans require approval (Scenario 1 - "Plan Approval Required")
#   2. Stock operations require ADDITIONAL step approval (Scenario 2 - "Step Approval Required")
#   3. Step approval dialog shows resolved parameters (e.g., symbol: "AAPL")
#
# Example flow for "What is the stock price of AAPL?":
#   Request -> Plan Generated -> [Plan Approval] -> Resume ->
#   stock_quote step -> [Step Approval with params] -> Resume -> Response

# -----------------------------------------------------------------------------
# General HITL Settings
# -----------------------------------------------------------------------------

# Timeout for human response before auto-action (default: 5m)
#TRUVAG3_HITL_DEFAULT_TIMEOUT=5m

# Number of retries before escalating to human (default: 3)
#TRUVAG3_HITL_ESCALATE_AFTER_RETRIES=3

# Redis Storage Configuration (DB 6 for HITL, separate from discovery DB 0, sessions DB 2)
#TRUVAG3_HITL_REDIS_DB=6
#TRUVAG3_HITL_KEY_PREFIX=truvag3:hitl

# Webhook URL for checkpoint notifications
# Local: http://localhost:PORT/internal/hitl-webhook
# K8s: http://agent-with-human-approval-service.truvag3-examples:80/internal/hitl-webhook
#TRUVAG3_HITL_WEBHOOK_URL=http://localhost:8098/internal/hitl-webhook

# =============================================================================
# LLM Debug Payload Store (Production Debugging)
# =============================================================================
# Captures complete LLM prompts and responses for debugging orchestration issues.

# Enable LLM debug capture (default: false)
TRUVAG3_LLM_DEBUG_ENABLED=true

# TTL for successful records (default: 24h)
#TRUVAG3_LLM_DEBUG_TTL=24h

# TTL for error records (default: 168h / 7 days)
#TRUVAG3_LLM_DEBUG_ERROR_TTL=168h

# =============================================================================
# Telemetry Configuration
# =============================================================================
# APP_ENV selects the telemetry profile:
#   - development: Console output, high verbosity, all traces
#   - staging: OTLP export, medium verbosity, sampled traces
#   - production: OTLP export, low verbosity, sampled traces

APP_ENV=development

# Development mode
DEV_MODE=false

# OpenTelemetry endpoint for distributed tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# Logging Configuration (Optional)
# =============================================================================
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
#TRUVAG3_DEBUG=true
#TRUVAG3_VALIDATE_PAYLOADS=false

# Execution Debug Store (stores orchestration DAGs in Redis DB 8)
TRUVAG3_EXECUTION_DEBUG_STORE_ENABLED=true

# =============================================================================
# Orchestration & HTTP Timeouts (HITL workflows need longer waits)
# =============================================================================
TRUVAG3_ORCHESTRATOR_MODE=autonomous
TRUVAG3_ORCHESTRATION_TIMEOUT=10m
TRUVAG3_HTTP_WRITE_TIMEOUT=10m
TRUVAG3_HTTP_READ_TIMEOUT=10m
