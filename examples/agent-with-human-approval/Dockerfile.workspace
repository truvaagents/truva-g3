# Workspace Dockerfile for agent-with-human-approval
# This Dockerfile builds with LOCAL modules using go.work (Go workspaces)
# Usage (from truvag3 root): docker build -f examples/agent-with-human-approval/Dockerfile.workspace -t agent-with-human-approval:latest .

FROM golang:1.26.2-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules that will be referenced by go.work
COPY ai/ ./ai/
COPY core/ ./core/
COPY orchestration/ ./orchestration/
COPY telemetry/ ./telemetry/
COPY resilience/ ./resilience/

# Copy the agent-with-human-approval example
COPY examples/agent-with-human-approval/ ./examples/agent-with-human-approval/

# Create go.work to use local modules (Go workspace best practice)
RUN echo 'go 1.26.2' > go.work && \
    echo '' >> go.work && \
    echo 'use (' >> go.work && \
    echo '    ./ai' >> go.work && \
    echo '    ./core' >> go.work && \
    echo '    ./orchestration' >> go.work && \
    echo '    ./telemetry' >> go.work && \
    echo '    ./resilience' >> go.work && \
    echo '    ./examples/agent-with-human-approval' >> go.work && \
    echo ')' >> go.work

WORKDIR /app/examples/agent-with-human-approval

# Configure Go build
ENV CGO_ENABLED=0
ENV GOOS=linux

# Download remaining dependencies (external ones not in workspace)
RUN go mod download

# Build the binary with optimizations
ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o agent-with-human-approval .

# Verify the binary was created
RUN ls -lh agent-with-human-approval

# Runtime stage
FROM alpine:3.23

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Copy binary from builder stage
COPY --from=builder /app/examples/agent-with-human-approval/agent-with-human-approval .

# Change ownership to non-root user
RUN chown appuser:appgroup /app/agent-with-human-approval && \
    chmod +x /app/agent-with-human-approval
USER appuser

# Set default PORT if not provided
ENV PORT=8098

# Expose port
EXPOSE ${PORT}

# Run the binary
ENTRYPOINT ["./agent-with-human-approval"]
