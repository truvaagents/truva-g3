# Scheduled Executor - Environment Variables
# Copy this file to .env and adjust values as needed.

# ==============================================================================
# Core Agent Configuration
# ==============================================================================

# Service port (registry allocation)
PORT=8380

# Kubernetes namespace for service discovery
NAMESPACE=truvag3-examples

# Development mode
DEV_MODE=false

# ==============================================================================
# Discovery / Queue Backend (REQUIRED)
# ==============================================================================

# Redis URL used for both task consumption and service discovery
# Redis / Valkey connection overrides
# Local execution defaults to standalone DB 0 at localhost:6379. Kubernetes
# manifests provide the in-cluster standalone URL. Uncomment only to override.
# REDIS_URL=redis://localhost:6379/0
#
# Cluster alternative. Never set this together with REDIS_URL.
# For Kubernetes, prefer k8-deployment/setup-redis-cluster-validation.sh so the
# URL shorthand is cleared before these structured settings are applied.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

TRUVAG3_AGENT_NAME=scheduled-executor
TRUVAG3_K8S_SERVICE_NAME=scheduled-executor-service
TRUVAG3_K8S_SERVICE_PORT=80

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Start a local Redis:
#    docker run --rm -p 6379:6379 redis:8.2.8-alpine
#
# 3. Run locally:
#    ./setup.sh run
#
# 4. Or deploy to Kind:
#    ./setup.sh full-deploy
