# =============================================================================
# GitHub Tool — Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# This is a passive Truva-G3 tool. It owns GitHub API access, artifact storage,
# and write calls for review comments. It does NOT own review policy or model
# calls — those belong to github-pr-review-agent.
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
PORT=8381
REDIS_URL=redis://localhost:6379
NAMESPACE=truvag3-examples
APP_ENV=development
DEV_MODE=false

# =============================================================================
# GitHub API
# =============================================================================
# Personal access token (classic) or fine-grained PAT with:
#   - pull_requests: read/write (for create_pr_review, create_issue_comment)
#   - contents: read (for get_pr_bundle, get_file_context)
GITHUB_TOKEN=

# Override for GitHub Enterprise. Leave default for github.com.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_UPLOAD_BASE_URL=https://uploads.github.com

# =============================================================================
# Artifact Store
# =============================================================================
# MVP supports only redis. filesystem/s3 are reserved for future implementations.
GITHUB_TOOL_ARTIFACT_BACKEND=redis

# How long stored patches/files are retained. Long-running review tasks rely
# on artifacts staying available; tune to the longest review timeout you expect.
GITHUB_TOOL_ARTIFACT_TTL=24h

# Per-payload byte caps. Reject anything larger to keep Redis memory bounded.
GITHUB_TOOL_MAX_PATCH_BYTES=2097152      # 2 MiB
GITHUB_TOOL_MAX_FILE_BYTES=1048576       # 1 MiB
GITHUB_TOOL_MAX_SLICE_BYTES=131072       # 128 KiB

# Maximum line span returned by get_file_context per call (before context_before
# / context_after expansions). Defends against unbounded range requests.
GITHUB_TOOL_MAX_CONTEXT_LINES=400

# =============================================================================
# Telemetry
# =============================================================================
# OTEL endpoint (in-cluster: http://otel-collector.truvag3-examples:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# Logging
# =============================================================================
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json

# =============================================================================
# Discovery Resilience (handles Redis startup race conditions)
# =============================================================================
TRUVAG3_DISCOVERY_RETRY=true
TRUVAG3_DISCOVERY_RETRY_INTERVAL=30s
