# my-tool configuration
# Copy this file to .env and fill in any required secrets (API keys, etc.)
# `.env` is gitignored. `.env.example` is checked in as the template.

# ---- Service identity ----
# Keep these consistent across setup.sh, k8-deployment.yaml, and the agent
# code (see TOOL_DEVELOPMENT_GUIDE.md §8 "Observability Identity").
TRUVAG3_K8S_SERVICE_NAME=my-tool-service
OTEL_SERVICE_NAME=my-tool

# ---- Redis (service discovery) ----
REDIS_URL=redis://localhost:6379
NAMESPACE=truvag3-examples

# ---- HTTP ----
PORT=8390

# ---- Telemetry / Observability ----
APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
DEV_MODE=true

# ---- External API credentials (UNCOMMENT + FILL IN if your tool needs them) ----
# Examples of patterns you'll see across the codebase:
#   GITHUB_TOKEN=ghp_...
#   POLYGON_API_KEY=...
#   FINNHUB_API_KEY=...
# When you add a key here, also reference it in k8-deployment.yaml via a
# Secret (envFrom: - secretRef: name: my-tool-secrets), and create the Secret
# from this .env file in setup.sh's setup_api_keys() helper.
