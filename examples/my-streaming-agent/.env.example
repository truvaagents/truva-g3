# my-streaming-agent configuration
# Copy this file to .env and fill in your AI provider key (required).
# `.env` is gitignored. `.env.example` is checked in as the template.
#
# This is a minimal template. For the full set of env vars supported by
# the framework (model aliases, retry tuning, semantic memory, etc.), see
# examples/travel-chat-agent/.env.example.

# ---- AI provider (REQUIRED — set at least one) ----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TRUVAG3_OPENROUTER_MODEL_DEFAULT=openai/gpt-5.6-sol
# Exact :free routes are experimental; no built-in OpenRouter free alias is advertised.
# GROQ_API_KEY=gsk-...        # Free tier available
# GEMINI_API_KEY=...

# ---- OpenAI model aliases ----
TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-5.6-terra
TRUVAG3_OPENAI_MODEL_FAST=gpt-5.6-luna
TRUVAG3_OPENAI_MODEL_SMART=gpt-5.6-sol

# ---- Service identity (keep consistent across setup.sh, k8-deployment.yaml, code) ----
TRUVAG3_K8S_SERVICE_NAME=my-streaming-agent-service
OTEL_SERVICE_NAME=my-streaming-agent

# ---- Redis (service discovery + session storage) ----
# Redis / Valkey connection overrides
# Local execution defaults to standalone DB 0 at localhost:6379. Kubernetes
# manifests provide the in-cluster standalone URL. Uncomment only to override.
# REDIS_URL=redis://localhost:6379/0
#
# Cluster alternative. Never set this together with REDIS_URL.
# For Kubernetes, prefer k8-deployment/setup-redis-cluster-validation.sh so the
# URL shorthand is cleared before these structured settings are applied.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default
NAMESPACE=truvag3-examples

# ---- HTTP ----
PORT=8391

# ---- Telemetry / Observability ----
APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
DEV_MODE=true

# ---- CORS for the chat-ui frontend (REQUIRED for browser UIs) ----
# The agent uses core.WithCORSDefaults() in code; no env var needed here,
# but if your domain restricts origins set them via TRUVAG3_CORS_ORIGINS.
# TRUVAG3_CORS_ORIGINS=http://chat.localhost
