# my-async-agent configuration
# Copy this file to .env and fill in your AI provider key (required).
# `.env` is gitignored. `.env.example` is checked in as the template.
#
# This is a minimal template. For the full set of env vars supported,
# see examples/event-driven-agent/.env.example.

# ---- AI provider (REQUIRED — set at least one) ----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk-...        # Free tier available
# GEMINI_API_KEY=...

# ---- Service identity ----
TRUVAG3_K8S_SERVICE_NAME=my-async-agent-service
OTEL_SERVICE_NAME=my-async-agent

# ---- Redis (service discovery + event queue) ----
REDIS_URL=redis://localhost:6379
NAMESPACE=truvag3-examples

# ---- HTTP (webhook receiver, health, capability discovery) ----
PORT=8392

# ---- Event processing ----
# Queue key prefix. Events are enqueued at <prefix>:<priority>:<id>
TRUVAG3_EVENT_QUEUE_PREFIX=my-async-agent:events
# Number of concurrent worker goroutines (per pod) consuming the queue
TRUVAG3_WORKER_CONCURRENCY=4
# Per-event processing timeout (orchestration soft-cap)
TRUVAG3_EVENT_TIMEOUT=5m
# Optional: bound how many events a single pod will process before
# graceful restart (helps with leak avoidance in long-lived processes)
# TRUVAG3_MAX_EVENTS_PER_POD=10000

# ---- HITL (human-in-the-loop approval, optional) ----
# Set to "true" if any handler requires human approval before write actions.
TRUVAG3_HITL_ENABLED=false
# TRUVAG3_HITL_TIMEOUT=24h

# ---- Telemetry / Observability ----
APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
DEV_MODE=true
