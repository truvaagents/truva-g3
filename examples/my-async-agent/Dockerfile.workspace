# Workspace Dockerfile for my-async-agent
# Usage (from truvag3 root): docker build -f examples/my-async-agent/Dockerfile.workspace -t my-async-agent:latest .

FROM golang:1.26.4-alpine AS builder

RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy 6 local modules
COPY ai/ ./ai/
COPY core/ ./core/
COPY memory/ ./memory/
COPY orchestration/ ./orchestration/
COPY telemetry/ ./telemetry/
COPY resilience/ ./resilience/

# Copy the my-async-agent example
COPY examples/my-async-agent/ ./examples/my-async-agent/

# Create go.work for local module resolution
RUN echo 'go 1.26.4' > go.work && \
    echo '' >> go.work && \
    echo 'use (' >> go.work && \
    echo '    ./ai' >> go.work && \
    echo '    ./core' >> go.work && \
    echo '    ./memory' >> go.work && \
    echo '    ./orchestration' >> go.work && \
    echo '    ./telemetry' >> go.work && \
    echo '    ./resilience' >> go.work && \
    echo '    ./examples/my-async-agent' >> go.work && \
    echo ')' >> go.work

WORKDIR /app/examples/my-async-agent

ENV CGO_ENABLED=0
ENV GOOS=linux

RUN go mod download

ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o my-async-agent .

RUN ls -lh my-async-agent

FROM alpine:3.23

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

COPY --from=builder /app/examples/my-async-agent/my-async-agent .

RUN chown appuser:appgroup /app/my-async-agent && \
    chmod +x /app/my-async-agent
USER appuser

ENV PORT=8392
EXPOSE ${PORT}

ENTRYPOINT ["./my-async-agent"]
