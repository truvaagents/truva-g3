# TruvaG3 Framework - API Keys Configuration
# Copy this file to .env and add your actual API keys
# NEVER commit .env files to version control

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-openai-org-id-here

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenRouter Configuration (optional)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TRUVAG3_OPENROUTER_MODEL_DEFAULT=openai/gpt-5.6-sol
# Exact :free routes are experimental; no built-in OpenRouter free alias is advertised.

# Groq Configuration
GROQ_API_KEY=gsk_your-groq-api-key-here

# Google AI (Gemini) Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# =============================================================================
# EXTERNAL SERVICE API KEYS
# =============================================================================

# Weather Service (for tool examples)
WEATHER_API_KEY=your-weather-api-key-here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# =============================================================================
# FRAMEWORK CONFIGURATION
# =============================================================================

# Development Mode
TRUVAG3_DEV_MODE=true

# Logging
LOG_LEVEL=info

# Redis (Local Development)
# Redis / Valkey connection overrides
# Local execution defaults to standalone DB 0 at localhost:6379. Kubernetes
# manifests provide the in-cluster standalone URL. Uncomment only to override.
# REDIS_URL=redis://localhost:6379/0
#
# Cluster alternative. Never set this together with REDIS_URL.
# For Kubernetes, prefer k8-deployment/setup-redis-cluster-validation.sh so the
# URL shorthand is cleared before these structured settings are applied.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default

# Telemetry (Optional - for local testing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
