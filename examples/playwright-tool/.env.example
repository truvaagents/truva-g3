# Playwright Tool Configuration
# Copy to .env and fill in values

# Redis (required)
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────────────────────
# S3 Storage (optional — tool runs without it in degraded mode)
# ──────────────────────────────────────────────────────────────────────────────
# Without S3:
#   stealth_browser, browser_test, explore_page    — fully functional
#   run_tests                                       — executes, artifacts not persisted
#   get_artifacts                                   — returns HTTP 503 S3_UNAVAILABLE
#   lookup_scripts                                  — depends on Redis store, not S3
#
# IMPORTANT — where these values are actually read:
#   - LOCAL DEV (`go run .` on your laptop): all variables below are read directly.
#   - KUBERNETES (`./setup.sh deploy`): only S3_ACCESS_KEY and S3_SECRET_KEY are
#     copied into the pod (via the playwright-s3-credentials Secret).
#     S3_BUCKET / S3_REGION / S3_ENDPOINT are filtered out by the ConfigMap
#     builder (see examples/k8-deployment/setup-env-lib.sh) and come from the
#     hardcoded values in k8-deployment.yaml instead. To change S3_BUCKET for
#     K8s, edit the manifest. To target in-cluster MinIO from the pod, add
#     an explicit S3_ENDPOINT entry to the manifest:
#       env:
#       - name: S3_ENDPOINT
#         value: "http://minio.truvag3-examples:9000"
# ──────────────────────────────────────────────────────────────────────────────

# Default: local MinIO running on your laptop (only applies to `go run .` local dev).
# Comment out the whole block to run in S3-degraded mode locally.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=truvag3-qa
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Alternative: real AWS S3 (for K8s deploys with `./setup.sh deploy`) ---
# Leave S3_ENDPOINT empty/unset; SDK uses standard AWS endpoints.
# Only S3_ACCESS_KEY / S3_SECRET_KEY make it into the pod via Secret.
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...

# Server
PORT=8349

# Playwright
PLAYWRIGHT_SCRIPT_DIR=./scripts
