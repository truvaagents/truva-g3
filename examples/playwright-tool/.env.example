# Playwright Tool Configuration
# Copy to .env and fill in values

# Redis (required)
REDIS_URL=redis://localhost:6379

# S3 Storage (optional — tool works without it but won't persist artifacts)
#
# For MinIO (local/dev):
#   S3_ENDPOINT=http://localhost:9000
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin
#
# For real AWS S3:
#   Leave S3_ENDPOINT empty (or unset) — SDK uses standard AWS endpoints
#   Credentials: set S3_ACCESS_KEY/S3_SECRET_KEY, or use IAM role/instance profile
#   The SDK auto-discovers credentials from: env vars → shared config → IAM role
#
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=truvag3-qa
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Server
PORT=8349

# Playwright
PLAYWRIGHT_SCRIPT_DIR=./scripts
