# Workspace Dockerfile for playwright-tool
# Builds with LOCAL modules (uses local core and telemetry)
# Usage (from truvag3 root): docker build -f examples/playwright-tool/Dockerfile.workspace -t playwright-tool:latest .

FROM golang:1.26.3-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules that are referenced by replace directives
COPY core/ ./core/
COPY telemetry/ ./telemetry/

# Copy the playwright-tool example
COPY examples/playwright-tool/ ./examples/playwright-tool/

WORKDIR /app/examples/playwright-tool

# Configure Go build
ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

# Download remaining dependencies and build
RUN go mod tidy && go mod download

# Build the binary with optimizations
ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o playwright-tool .

# Verify the binary was created
RUN ls -lh playwright-tool

# Runtime stage — Debian for full glibc compatibility + Node.js + Playwright
FROM debian:bookworm-slim

# Install runtime dependencies including Node.js and Chromium deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    # --- Node.js / Playwright prerequisites ---
    nodejs \
    npm \
    # Chromium shared-library dependencies (Playwright downloads its own binary)
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    libgtk-3-0 \
    libx11-xcb1 \
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright with bundled Chromium, plus stealth plugin.
# Store browsers in a shared path so the non-root runtime user can access them.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN npm install -g playwright @playwright/test playwright-extra puppeteer-extra-plugin-stealth \
    puppeteer-extra-plugin-user-preferences puppeteer-extra-plugin-user-data-dir \
    && npx playwright install chromium

# Ensure Node.js can find globally-installed modules when invoked via `node`
ENV NODE_PATH=/usr/local/lib/node_modules

WORKDIR /app

# Create non-root user for security
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -m -s /bin/bash appuser

# Grant the non-root user read+execute access to Playwright browsers
RUN chmod -R o+rX /opt/playwright-browsers

# Copy Go binary from builder stage
COPY --from=builder /app/examples/playwright-tool/playwright-tool .

# Copy explore.js script
COPY examples/playwright-tool/scripts/ /app/scripts/

RUN chown -R appuser:appgroup /app && \
    chmod +x /app/playwright-tool

# Create working directories for browser runs
RUN mkdir -p /tmp/playwright-runs && chown appuser:appgroup /tmp/playwright-runs

USER appuser

# Default script directory
ENV PLAYWRIGHT_SCRIPT_DIR=/app/scripts
ENV PORT=8349

EXPOSE ${PORT}
ENTRYPOINT ["./playwright-tool"]
