# Supported viewer-owned local setting. Explicit process environment takes precedence.
# Add the domains used by your agents; the generic default stays infrastructure.
TRUVAG3_VIEWER_MEMORY_DOMAINS=infrastructure

# Redis reference only: keep the following lines commented in this file.
# This .env accepts only TRUVAG3_VIEWER_MEMORY_DOMAINS.
# Supply Redis overrides through the process environment; see README Configuration.
# The shared infrastructure supplies the Redis defaults.
# Read-only application inspection overrides use the process environment too:
# TRUVAG3_VIEWER_APPLICATION_READ_TIMEOUT=15s
# TRUVAG3_VIEWER_APPLICATION_READ_MAX_BYTES=1048576
# REDIS_URL=redis://localhost:6379/0
# Cluster alternative. Never set this together with REDIS_URL.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default
