# Server and Ollama
SIMULATOR_ADDR=127.0.0.1:18080
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_REQUEST_TIMEOUT=3m

# Simulated enterprise OAuth/application configuration
ENTERPRISE_CLIENT_ID=travel-chat-agent
ENTERPRISE_CLIENT_SECRET=local-enterprise-secret
ENTERPRISE_APP_KEY=travel-chat-app
ENTERPRISE_DEPLOYMENT=gpt-4o-mini
ENTERPRISE_TOKEN_TTL=5m
ENTERPRISE_REQUIRED_STOP=<|im_end|>
ENTERPRISE_STRICT_AUTH_HEADERS=true

# Optional: require this exact query parameter or change the returned model name.
# ENTERPRISE_API_VERSION=2024-08-01-preview
# ENTERPRISE_RESPONSE_MODEL=gpt-4o-mini-2024-07-18

# Values consumed by examples/travel-chat-agent when it runs locally.
ENTERPRISE_BASE_HOST=http://127.0.0.1:18080
ENTERPRISE_TOKEN_URL=http://127.0.0.1:18080/oauth2/token
