# Process role: api | worker | scheduler | scheduled-executor | target-agent
TRUVAG3_MODE=api

# Dedicated Kind cluster. These host ports intentionally differ from the
# normal examples cluster's 80/443 ingress mappings.
TRUVAG3_CLUSTER_NAME=
PORTABILITY_HTTP_PORT=18080
PORTABILITY_HTTPS_PORT=18443

# Application identity and HTTP behavior
PORT=8080
NAMESPACE=truvag3-examples
DEV_MODE=false
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
APP_ENV=development

# Provider endpoints. setup.sh supplies cluster-local values and generates a
# PostgreSQL password in a Kubernetes Secret. Set these only for local runs.
POSTGRES_URL=
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379

# Optional setup-time password override. Leave empty to generate one once per
# cluster. It is never copied into a ConfigMap or printed by setup.sh.
PORTABILITY_POSTGRES_PASSWORD=

# Example-owned logical isolation and transport settings
PORTABILITY_BACKEND_NAMESPACE=orchestration-portability
PORTABILITY_QUEUE=portable-weather
PORTABILITY_WORKFLOW_ID=portable-weather-workflow
PORTABILITY_ACK_WAIT=2m

# Optional OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
