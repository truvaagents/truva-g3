FROM alpine:3.23

RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -g 10001 -S portability && \
    adduser -u 10001 -S portability -G portability

WORKDIR /app
COPY .build/portability.test /app/portability.test
RUN chown portability:portability /app/portability.test && chmod 0555 /app/portability.test

USER portability
ENTRYPOINT ["/app/portability.test", "-test.v", "-test.count=1", "-test.timeout=2m"]
