# openclaw-tool configuration
# Copy this file to .env and fill in any required secrets (API keys, etc.)
# `.env` is gitignored. `.env.example` is checked in as the template.

# ---- Service identity ----
# Keep these consistent across setup.sh, k8-deployment.yaml, and the agent
# code (see TOOL_DEVELOPMENT_GUIDE.md §8 "Observability Identity").
TRUVAG3_K8S_SERVICE_NAME=openclaw-tool-service
OTEL_SERVICE_NAME=openclaw-tool

# ---- Redis (service discovery) ----
REDIS_URL=redis://localhost:6379
NAMESPACE=truvag3-examples

# ---- HTTP ----
PORT=8393

# ---- Telemetry / Observability ----
APP_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
# DEV_MODE=true forces human-readable TEXT logs + debug level — it OVERRIDES
# TRUVAG3_LOG_FORMAT (core.WithDevelopmentMode sets Logging.Format="text"). Keep this
# false so logs are JSON for Loki/structured aggregation; flip to true for local readability.
DEV_MODE=false

# ---- OpenClaw sidecar (secrets — consumed by setup.sh's setup_api_keys) ----
# Gateway bearer token. If left empty, setup.sh generates an ephemeral one.
OPENCLAW_GATEWAY_TOKEN=
# OpenClaw's OWN LLM key — independent of any TruvaG3 agent key (ANALYSIS.md §2).
# OpenAI is the default: config/openclaw.json is wired to provider "openai"
# (model openai/gpt-5.4-mini, apiKey ${OPENAI_API_KEY}), so just set OPENAI_API_KEY.
# To switch providers, uncomment that provider's key below AND repoint
# config/openclaw.json (its `models.providers` block + `model.primary`) at it.
# setup.sh injects whichever of these keys are present in .env.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=        # Anthropic (Claude)
# OPENROUTER_API_KEY=       # OpenRouter (also update config/openclaw.json)
# Exact :free routes are experimental; verify current OpenRouter availability and limits.
# GROQ_API_KEY=             # Groq
# GEMINI_API_KEY=           # Google Gemini
# DEEPSEEK_API_KEY=         # DeepSeek
# XAI_API_KEY=              # xAI (Grok)
# MISTRAL_API_KEY=          # Mistral
# TOGETHER_API_KEY=         # Together AI
# QWEN_API_KEY=             # Qwen (Alibaba)

# ---- OpenClaw transaction tuning (optional; k8-deployment.yaml sets these inline) ----
# Override here only for `./setup.sh run` (local) or to change the deployed defaults.
# OPENCLAW_URL=http://127.0.0.1:18789
# OPENCLAW_AGENT_ID=main
# OPENCLAW_IMAGE=openclaw:local          # sidecar image tag setup.sh loads into kind
# MAX_INPUT_CHARS=1000000                 # size cap; protects the Node heap (§9)
# DEFAULT_TIMEOUT_SECONDS=300             # transaction default
# MAX_TIMEOUT_SECONDS=900                 # transaction ceiling
# SEM_ACQUIRE_TIMEOUT_SECONDS=5           # bounded wait before 503 BUSY (§7)
