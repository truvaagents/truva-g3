# =============================================================================
# GitHub PR Review Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# This agent uses CHAIN CLIENT for production-grade resilience:
#   - Automatic failover across configured providers
#   - You only need ONE provider configured, but more = better resilience
# =============================================================================

# =============================================================================
# AI Provider API Keys (Chain Client)
# =============================================================================
# Configure multiple providers for high availability.

# OpenAI - Primary provider (RECOMMENDED for code review)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - First fallback (Claude — strong on code)
# https://console.anthropic.com/
#ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini - Alternative provider
# https://aistudio.google.com/apikey
#GEMINI_API_KEY=your-gemini-key-here

# Groq - Fast/cheap inference for manifest + merge phases
# https://console.groq.com/keys
#GROQ_API_KEY=gsk-your-groq-key-here

# =============================================================================
# OpenAI-Compatible Providers (DeepSeek, xAI, Together, Qwen, Ollama)
# =============================================================================
# Use any OpenAI-compatible API by setting OPENAI_BASE_URL, or use the
# provider-specific env vars below.
#DEEPSEEK_API_KEY=
#XAI_API_KEY=
#TOGETHER_API_KEY=
#QWEN_API_KEY=
#MISTRAL_API_KEY=
#OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# Model Aliases — Per-Phase Model Selection
# =============================================================================
# Pattern: TRUVAG3_{PROVIDER}_MODEL_{ALIAS}=actual-model-name
# Aliases:  default | smart | fast
TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-5.6-terra
TRUVAG3_OPENAI_MODEL_FAST=gpt-5.6-luna
TRUVAG3_OPENAI_MODEL_SMART=gpt-5.6-sol
#TRUVAG3_ANTHROPIC_MODEL_DEFAULT=claude-3-5-sonnet-latest
#TRUVAG3_GROQ_MODEL_DEFAULT=llama-3.1-8b-instant

# Phase-specific model selection (uses aliases above).
# Shard review uses smart; merge/dedup uses fast.
# MANIFEST_MODEL is RESERVED — the manifest pass for huge PRs is not yet
# implemented (see PROPOSAL.md "MVP Scope"); the env var is kept here so
# future code can read it without breaking deployment configs.
TRUVAG3_PR_REVIEW_MANIFEST_MODEL=fast
TRUVAG3_PR_REVIEW_SHARD_MODEL=smart
TRUVAG3_PR_REVIEW_MERGE_MODEL=fast

# =============================================================================
# Service Configuration
# =============================================================================
PORT=8382
REDIS_URL=redis://localhost:6379
NAMESPACE=truvag3-examples
APP_ENV=development

# Deployment mode: blank = embedded (api+worker in one process); or "api" / "worker"
TRUVAG3_MODE=
WORKER_COUNT=3
TRUVAG3_PR_REVIEW_TASK_TIMEOUT=30m

# Development mode — verbose logging, mock-friendly defaults
DEV_MODE=false

# =============================================================================
# GitHub Webhook
# =============================================================================
# Secret used to verify X-Hub-Signature-256 on incoming pull_request events.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Review draft PRs (default: false — drafts are skipped)
TRUVAG3_PR_REVIEW_REVIEW_DRAFTS=false

# =============================================================================
# Posting Policy (write operations — start in dry-run)
# =============================================================================
# When true, every gate must pass before a review is posted to GitHub.
TRUVAG3_PR_REVIEW_DEFAULT_POST=false

# Comma-separated owner/repo allowlist for auto-posting.
TRUVAG3_PR_REVIEW_ALLOWED_REPOS=

# Allow REQUEST_CHANGES (otherwise downgrade to COMMENT).
TRUVAG3_PR_REVIEW_ALLOW_REQUEST_CHANGES=false

# Minimum confidence required for a finding to drive REQUEST_CHANGES.
TRUVAG3_PR_REVIEW_REQUEST_CHANGES_MIN_CONFIDENCE=0.90

# Dry-run mode — produces results without writing to GitHub.
TRUVAG3_PR_REVIEW_DRY_RUN=true

# Global posting kill-switch (flippable without redeploy).
TRUVAG3_PR_REVIEW_POSTING_DISABLED=false

# Throttle: at most one posted review per (owner, repo, head SHA) per interval.
TRUVAG3_PR_REVIEW_POST_MIN_INTERVAL=1h

# =============================================================================
# Review Strategy
# =============================================================================
# Active in MVP — these knobs control sharded review:
TRUVAG3_PR_REVIEW_MAX_SHARD_TOKENS=60000
TRUVAG3_PR_REVIEW_MAX_PARALLEL_SHARDS=4
TRUVAG3_PR_REVIEW_SKIP_GENERATED=true
TRUVAG3_PR_REVIEW_SKIP_LOCKFILES=true

# RESERVED for future enhancement — currently NO-OP. PROPOSAL.md describes
# three review modes (small whole-PR, medium sharded, huge with manifest pass);
# the MVP only implements the sharded path. These two thresholds and the
# manifest-model alias are kept here so future code can read them without
# breaking deployment configs. Until the whole-PR / manifest paths land,
# every PR is sharded regardless of size. See PROPOSAL.md "MVP Scope" note.
TRUVAG3_PR_REVIEW_MAX_WHOLE_PR_TOKENS=80000
TRUVAG3_PR_REVIEW_HUGE_PR_TOKEN_THRESHOLD=500000

# =============================================================================
# Framework — never distill raw code being reviewed
# =============================================================================
# Distillation lossily compresses tool results. Reviews need exact code, so
# this MUST stay disabled. ResultTrim is mandatory and cannot be disabled
# here — the agent keeps raw code out of step results entirely.
TRUVAG3_RESULT_DISTILL_ENABLED=false

# =============================================================================
# Telemetry
# =============================================================================
# OTEL endpoint (in-cluster: http://otel-collector.truvag3-examples:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# LLM debug payload store (captures full prompts/responses in Redis DB 7)
TRUVAG3_LLM_DEBUG_ENABLED=true

# Execution Debug Store (orchestration DAGs in Redis DB 8 — Registry Viewer reads this)
TRUVAG3_EXECUTION_DEBUG_STORE_ENABLED=true

# =============================================================================
# Logging
# =============================================================================
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
#TRUVAG3_DEBUG=true

# =============================================================================
# Timeouts (PR review work can be long-running; align HTTP with task timeout)
# =============================================================================
TRUVAG3_HTTP_READ_TIMEOUT=15m
TRUVAG3_HTTP_WRITE_TIMEOUT=15m

# =============================================================================
# Discovery Resilience (handles Redis startup race conditions)
# =============================================================================
TRUVAG3_DISCOVERY_RETRY=true
TRUVAG3_DISCOVERY_RETRY_INTERVAL=30s

# =============================================================================
# Shared Agent Memory
# =============================================================================
# The agent emits an episodic `review_completed` event after every PR review.
# Other agents in the same domain (devops-chat-agent, event-driven-agent) and
# the registry viewer can see these events without a custom history API.
#
# Domain is hardcoded to "infrastructure" in main.go (matches the existing
# pool of devops/infra agents). Setting TRUVAG3_AGENT_DOMAIN here is currently
# read by some framework subsystems but the WithDomain option in main.go
# overrides it for memory; treat this as informational.
TRUVAG3_AGENT_DOMAIN=infrastructure

# Phase 2 (semantic knowledge extraction via reflection job) is deliberately
# disabled in this agent — we're a producer of events, not a consumer of
# synthesized knowledge. The reflection job already running on
# devops-chat-agent consumes our events on its own cadence. The Phase 2 vars
# below are exposed for operator opt-in only; they have no effect on this
# agent unless the WithKnowledgeDisabled() call in main.go is removed.
TRUVAG3_DEPLOY_QDRANT=false
TRUVAG3_VECTOR_DB_URL=qdrant.truvag3-examples:6334
TRUVAG3_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
TRUVAG3_EMBEDDING_MODEL=nomic-embed-text
