# Workspace Dockerfile for github-pr-review-agent
# Builds with LOCAL framework modules (used during framework development).
# Usage (from truvag3 repo root):
#   docker build -f examples/github-pr-review-agent/Dockerfile.workspace \
#                -t github-pr-review-agent:latest .

FROM golang:1.27.0-alpine AS builder

# Build dependencies (CGO disabled, so no C toolchain needed)
RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Copy local modules referenced by replace directives
COPY ai/ ./ai/
COPY core/ ./core/
COPY memory/ ./memory/
COPY orchestration/ ./orchestration/
COPY telemetry/ ./telemetry/
COPY resilience/ ./resilience/

# Copy the agent example
COPY examples/github-pr-review-agent/ ./examples/github-pr-review-agent/

WORKDIR /app/examples/github-pr-review-agent

# Configure Go build
ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

# Resolve replace-directive deps and download remaining
RUN go mod tidy && go mod download

# Build the binary
ARG TARGETARCH=arm64
RUN go build -trimpath -buildvcs=false \
    -ldflags '-w -s' \
    -o github-pr-review-agent .

# Runtime stage
FROM alpine:3.23

# Install runtime deps and create non-root user in one layer
RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

WORKDIR /app

# Copy binary from builder stage (ownership set at copy time)
COPY --from=builder --chown=appuser:appgroup \
    /app/examples/github-pr-review-agent/github-pr-review-agent .

USER appuser

# Set default PORT if not provided
ENV PORT=8382

# Expose port
EXPOSE ${PORT}

# Run the binary
ENTRYPOINT ["./github-pr-review-agent"]
