# Demographics Tool - Environment Variables
# Copy to .env and configure

# Required: Redis URL for service discovery
REDIS_URL=redis://localhost:6379

# Optional: Census Bureau API key (works without, limited to 500 requests/day)
# Get a free key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: Service port (default: 8365)
PORT=8365

# Optional: Kubernetes namespace
NAMESPACE=truvag3-examples

# Optional: Development mode
DEV_MODE=true

# Optional: Application environment (development/staging/production)
APP_ENV=development

# Optional: Log configuration
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json

# Optional: OpenTelemetry endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
