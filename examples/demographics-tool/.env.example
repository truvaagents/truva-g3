# Demographics Tool - Environment Variables
# Copy to .env and configure

# Redis connection overrides for service discovery
# Redis / Valkey connection overrides
# Local execution defaults to standalone DB 0 at localhost:6379. Kubernetes
# manifests provide the in-cluster standalone URL. Uncomment only to override.
# REDIS_URL=redis://localhost:6379/0
#
# Cluster alternative. Never set this together with REDIS_URL.
# For Kubernetes, prefer k8-deployment/setup-redis-cluster-validation.sh so the
# URL shorthand is cleared before these structured settings are applied.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default

# Optional: Census Bureau API key (works without, limited to 500 requests/day)
# Get a free key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: Service port (default: 8365)
PORT=8365

# Optional: Kubernetes namespace
NAMESPACE=truvag3-examples

# Optional: Development mode
DEV_MODE=true

# Optional: Application environment (development/staging/production)
APP_ENV=development

# Optional: Log configuration
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json

# Optional: OpenTelemetry endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
