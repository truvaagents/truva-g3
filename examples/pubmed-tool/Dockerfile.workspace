# Workspace Dockerfile for pubmed-tool
# Usage (from truvag3 root): docker build -f examples/pubmed-tool/Dockerfile.workspace -t pubmed-tool:latest .

FROM golang:1.26.3-alpine AS builder

RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules referenced by replace directives
COPY core/ ./core/
COPY telemetry/ ./telemetry/

# Copy the pubmed-tool example
COPY examples/pubmed-tool/ ./examples/pubmed-tool/

WORKDIR /app/examples/pubmed-tool

ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

RUN go mod tidy && go mod download

ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o pubmed-tool .

RUN ls -lh pubmed-tool

FROM alpine:3.23

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

COPY --from=builder /app/examples/pubmed-tool/pubmed-tool .

RUN chown appuser:appgroup /app/pubmed-tool && \
    chmod +x /app/pubmed-tool
USER appuser

ENV PORT=8366

EXPOSE ${PORT}

ENTRYPOINT ["./pubmed-tool"]
