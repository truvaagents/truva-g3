# Workspace Dockerfile for semantic-scholar-tool
# Usage (from truvag3 root): docker build -f examples/semantic-scholar-tool/Dockerfile.workspace -t semantic-scholar-tool:latest .

FROM golang:1.27.0-alpine AS builder

RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules that are referenced by replace directives
COPY core/ ./core/
COPY telemetry/ ./telemetry/

# Copy the semantic-scholar-tool example
COPY examples/semantic-scholar-tool/ ./examples/semantic-scholar-tool/

WORKDIR /app/examples/semantic-scholar-tool

ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

RUN go mod tidy && go mod download

ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o semantic-scholar-tool .

RUN ls -lh semantic-scholar-tool

# Runtime stage
FROM alpine:3.23

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

COPY --from=builder /app/examples/semantic-scholar-tool/semantic-scholar-tool .

RUN chown appuser:appgroup /app/semantic-scholar-tool && \
    chmod +x /app/semantic-scholar-tool
USER appuser

ENV PORT=8370

EXPOSE ${PORT}

ENTRYPOINT ["./semantic-scholar-tool"]
