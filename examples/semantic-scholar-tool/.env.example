# Semantic Scholar Tool - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# Core Tool Configuration
# ==============================================================================

# Service port (default: 8370)
PORT=8370

# Kubernetes namespace for service discovery (default: truvag3-examples)
NAMESPACE=truvag3-examples

# Development mode - enables detailed logging (default: false)
# Set to "true" for local development
DEV_MODE=false

# ==============================================================================
# Discovery Configuration (REQUIRED)
# ==============================================================================

# Redis URL for service discovery and registration
# Format: redis://[username:password@]host:port[/database]
# Examples:
#   - Local: redis://localhost:6379
#   - K8s: redis://redis-service.truvag3-examples.svc.cluster.local:6379
#   - Auth: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Application Configuration
# ==============================================================================

# Semantic Scholar API key (strongly recommended)
# Without a key, requests share a global rate limit pool and will hit 429s.
# Request a key at: https://www.semanticscholar.org/product/api#api-key-form
# Free tier includes:
#   - 1 request per second (unauthenticated)
#   - 10 requests per second (with key)
#   - 100 requests per second (partner tier)
S2_API_KEY=

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: error, warn, info, debug (default: info)
TRUVAG3_LOG_LEVEL=info

# Log format: json, text (default: json for production)
# Use "text" for easier local development reading
TRUVAG3_LOG_FORMAT=json

# ==============================================================================
# Kubernetes-Specific Configuration (Optional)
# ==============================================================================

# Service name for K8s service discovery (default: derived from tool name)
TRUVAG3_K8S_SERVICE_NAME=semantic-scholar-service

# Pod name - automatically set by K8s (don't set manually)
# TRUVAG3_K8S_POD_NAME=semantic-scholar-tool-xyz123

# ==============================================================================
# Telemetry Configuration (Optional)
# ==============================================================================

# Application environment profile (default: development)
APP_ENV=development

# OpenTelemetry collector endpoint
# Format: http://host:port
# Example: http://otel-collector.truvag3-examples:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name for telemetry (default: semantic-scholar)
OTEL_SERVICE_NAME=semantic-scholar-service

# ==============================================================================
# Development-Only Settings
# ==============================================================================

# For local Kind cluster development:
# NAMESPACE=truvag3-examples
# REDIS_URL=redis://redis-service.truvag3-examples.svc.cluster.local:6379
# DEV_MODE=true
# TRUVAG3_LOG_FORMAT=text

# ==============================================================================
# Getting Started
# ==============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. (Recommended) Get your Semantic Scholar API key:
#    - Visit: https://www.semanticscholar.org/product/api#api-key-form
#    - Fill out the request form
#    - Paste your key in S2_API_KEY above
#    - Without a key, requests are heavily rate-limited (1 req/sec shared pool)
#
# 3. For local testing:
#    export $(cat .env | xargs)
#    go run .
#
# 4. For Kubernetes deployment:
#    Update the secret in k8-deployment.yaml with your API key
#    ./setup.sh deploy
#
