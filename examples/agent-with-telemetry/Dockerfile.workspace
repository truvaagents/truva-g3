# Workspace Dockerfile for research-agent-telemetry
# This Dockerfile builds with LOCAL modules (includes component-aware logging)
# Usage (from truvag3 root): docker build -f examples/agent-with-telemetry/Dockerfile.workspace -t research-agent-telemetry:latest .

FROM golang:1.26.3-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev ca-certificates

WORKDIR /app

# Copy local modules that are referenced by replace directives
COPY ai/ ./ai/
COPY core/ ./core/
COPY telemetry/ ./telemetry/

# Copy the agent-with-telemetry example
COPY examples/agent-with-telemetry/ ./examples/agent-with-telemetry/

WORKDIR /app/examples/agent-with-telemetry

# Configure Go build
ENV GOWORK=off
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GONOSUMDB=github.com/truvaagents/truva-g3/*

# Download remaining dependencies and build
RUN go mod tidy && go mod download

# Build the binary with optimizations
ARG TARGETARCH=arm64
RUN go build -a -installsuffix cgo \
    -ldflags '-w -s -extldflags "-static"' \
    -o research-agent-telemetry .

# Verify the binary was created
RUN ls -lh research-agent-telemetry

# Runtime stage
FROM alpine:3.23

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Copy binary from builder stage
COPY --from=builder /app/examples/agent-with-telemetry/research-agent-telemetry .

# Change ownership to non-root user
RUN chown appuser:appgroup /app/research-agent-telemetry && \
    chmod +x /app/research-agent-telemetry
USER appuser

# Set default PORT if not provided
ENV PORT=8092

# Expose port
EXPOSE ${PORT}

# Run the binary
ENTRYPOINT ["./research-agent-telemetry"]
