// Docusaurus transpiles without typechecking. CI and editors use this config;
// run the same check locally with `npm run typecheck`.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // Clear the inherited option removed in TypeScript 7.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    },
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
