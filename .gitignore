# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Node.js dependencies (docs-site uses npm; any future Node project too)
node_modules/

# Python build artifacts (in case any Python tooling lands later)
__pycache__/
*.pyc
*.pyo

# Generic build caches
.cache/

# Local CLI state — may contain auth tokens or per-session data
.wrangler/
.claude/

# env file
.env
.env.local

# IDE specific files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.DS_Store

# AI coding assistant local config
.claude/

# Build artifacts
/bin/
/dist/
/build/
/tmp/

# Example binaries — Go builds produce binaries matching the directory name
examples/*/[a-z]*-[a-z]*
examples/*/[a-z]*-[a-z]*-[a-z]*
examples/*/[a-z]*-[a-z]*-[a-z]*-[a-z]*
# Exclude false positives (source files matching the pattern)
!examples/*/*.go
!examples/*/*.mod
!examples/*/*.sum
!examples/*/*.sh
!examples/*/*.yaml
!examples/*/*.yml
!examples/*/*.md
!examples/*/*.html
!examples/*/*.css
!examples/*/*.js
!examples/*/*.json
!examples/*/*.example
!examples/*/Dockerfile*
!examples/*/Makefile
!examples/*/.env.example
!examples/*/.gitignore
!examples/*/nginx.conf

# Screenshots (local testing artifacts)
Screenshot *.png

# Debug/sample data files
dag-*.json
!docs/blogs/dag-*.json

# Coverage files
coverage.txt
coverage.html
*.cov

# Local testing artifacts
*.log
*.pid

# Temporary files
*.tmp
.tmp/

# Debug files
debug
__debug_bin

# Air live reload
.air.toml
tmp/DEVELOPER_FRIENDLY_UPDATES.md

# Implementation plans (internal documentation)
examples/agent-with-telemetry/IMPLEMENTATION_PLAN.md

# Internal research drafts (not tracked)
docs/PAPER_DRAFT_3PHASE_PROGRESSIVE_ENHANCEMENT.md
docs/PAPER_NOVELTY_ASSESSMENT.md
docs/REDIS_DEPENDENCY_ANALYSIS.md

# Generated by docs-site/package.json `prebuild`/`prestart` hooks (see
# scripts/rewrite-getting-started-links.py). Source of truth is
# GETTING_STARTED.md at the repo root.
docs/getting-started.md
